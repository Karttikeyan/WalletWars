<script>
// ══ MODAL ══
function openModal() {
  document.getElementById('modalOverlay').classList.add('open');
}
function closeModal() {
  document.getElementById('modalOverlay').classList.remove('open');
}
document.getElementById('modalOverlay').addEventListener('click', function(e) {
  if (e.target === this) closeModal();
});

// ══ WALLET ══
let walletAddress = null;
let sessionToken = null;

async function connectWallet(type) {
  if (type === 'walletconnect') {
    alert('WalletConnect coming soon — please use MetaMask or Coinbase Wallet for now.');
    return;
  }
  if (typeof window.ethereum === 'undefined') {
    alert('No wallet detected. Please install MetaMask or Coinbase Wallet.');
    return;
  }
  try {
    const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });
    const address = ethers.getAddress(accounts[0]);

    const nonceRes = await fetch(`/api/auth/nonce/${address}`);
    const { nonce } = await nonceRes.json();

    const domain = window.location.host;
    const uri = window.location.origin;
    const issuedAt = new Date().toISOString();
    const message = `${domain} wants you to sign in with your Ethereum account:\n${address}\n\nSign in to WalletWars\n\nURI: ${uri}\nVersion: 1\nChain ID: 8453\nNonce: ${nonce}\nIssued At: ${issuedAt}`;

    const signature = await window.ethereum.request({
      method: 'personal_sign',
      params: [message, address],
    });

    const verifyRes = await fetch('/api/auth/verify', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message, signature }),
    });
    const verifyData = await verifyRes.json();

    if (!verifyRes.ok || !verifyData.ok) {
      alert('Login failed: ' + (verifyData.error || 'unknown error'));
      return;
    }

    walletAddress = verifyData.address;
    sessionToken = verifyData.token;

    closeModal();
    setTimeout(() => startForging(), 300);
  } catch (err) {
    console.error('Wallet connection error:', err);
    if (err.code === 4001) return; // usuario rechazo la firma, sin error agresivo
    alert('Something went wrong connecting your wallet. Please try again.');
  }
}

// ══ COMBAT CARD ENGINE (real, de combat-card-v2-1.html) ══
let WALLET = '0xAC3a89EA9dA567e86E97FEe815b90b804dd2fc55';
let seed, hue, hue2, pattern, chaos, density;
let currentRank = 'bronze';
let cardPower = 4080;

function hashSeed(str){ let h=0; for(let i=0;i<str.length;i++){ h=Math.imul(31,h)+str.charCodeAt(i)|0; } return Math.abs(h); }
function seededRand(s,n){ const x=Math.sin(s+n)*10000; return x-Math.floor(x); }

function setWalletSeed(addr){
  WALLET = addr;
  seed    = hashSeed(addr);
  hue     = Math.floor(seededRand(seed,1)*360);
  hue2    = (hue+120+Math.floor(seededRand(seed,2)*60))%360;
  pattern = Math.floor(seededRand(seed,3)*5);
  chaos   = seededRand(seed,4);
  density = 0.4 + seededRand(seed,5)*0.6;
}
setWalletSeed(WALLET);

const RANK_CONFIG = {
  bronze:  { label:'🥉 BRONZE', badgeColor:'rgba(139,90,43,0.6)', labelColor:'#8B6520', medallionBorder:'#8B5E2A', medallionBg:'radial-gradient(circle,#1c0e06,#0a0604)', medallionGlow:'rgba(100,60,20,0.4)', nameColor:'#C9A84C', powerGradient:'linear-gradient(to right,#8B6914,#C9A84C,#F0D080)', powerColor:'#C9A84C', saturation:0.2, brightness:0.5, particles:[], scars:0, metal:['#4a3310','#C9A84C','#F0D080'], overlay:'linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.1) 40%, rgba(0,0,0,0.7) 100%)' },
  silver:  { label:'🥈 SILVER', badgeColor:'rgba(168,180,192,0.7)', labelColor:'#A8B4C0', medallionBorder:'#A8B4C0', medallionBg:'radial-gradient(circle,#1a1e22,#0a0e12)', medallionGlow:'rgba(168,180,192,0.35)', nameColor:'#D0DDE8', powerGradient:'linear-gradient(to right,#4a5568,#A8B4C0,#E2E8F0)', powerColor:'#A8B4C0', saturation:0.45, brightness:0.65, particles:['silver'], scars:1, metal:['#343c48','#A8B4C0','#EAF0F6'], overlay:'linear-gradient(to bottom, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.05) 40%, rgba(0,0,0,0.75) 100%)' },
  gold:    { label:'🥇 GOLD', badgeColor:'rgba(201,168,76,0.9)', labelColor:'#F0D080', medallionBorder:'#C9A84C', medallionBg:'radial-gradient(circle,#2a1a0a,#0e0a04)', medallionGlow:'rgba(201,168,76,0.6)', nameColor:'#F0D080', powerGradient:'linear-gradient(to right,#8B6914,#C9A84C,#F0D080)', powerColor:'#F0D080', saturation:0.85, brightness:0.85, particles:['fire','gold'], scars:2, metal:['#5e4410','#E2C266','#FFF2CC'], overlay:'linear-gradient(to bottom, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0) 40%, rgba(0,0,0,0.8) 100%)' },
  diamond: { label:'💎 DIAMOND', badgeColor:'rgba(201,168,76,0.9)', labelColor:'#80c0ff', medallionBorder:'#C9A84C', medallionBg:'radial-gradient(circle,#0d1e30,#060e18)', medallionGlow:'rgba(80,160,220,0.5)', nameColor:'#a0d0ff', powerGradient:'linear-gradient(to right,#0a1e30,#1a5080,#80c0ff)', powerColor:'#80c0ff', saturation:1.0, brightness:1.0, particles:['crystal','gold'], scars:3, metal:['#0a1c30','#4a90d9','#a0d0ff'], overlay:'linear-gradient(to bottom, rgba(5,15,30,0.2) 0%, rgba(0,0,0,0) 40%, rgba(5,10,20,0.85) 100%)' },
  legend:  { label:'👑 BASE LEGEND', badgeColor:'rgba(240,208,128,1)', labelColor:'#F0D080', medallionBorder:'#F0D080', medallionBg:'radial-gradient(circle,#2a1800,#150b00)', medallionGlow:'rgba(240,208,128,0.9)', nameColor:'#F0D080', powerGradient:'conic-gradient(from 0deg, #8B6914, #C9A84C, #F0D080, #CC2200, #F0D080, #C9A84C, #8B6914)', powerColor:'#F0D080', saturation:1.2, brightness:1.2, particles:['fire','gold','legend'], scars:4, metal:['#7a5d10','#F0D080','#FFF6DC'], overlay:'linear-gradient(to bottom, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0) 50%, rgba(0,0,0,0.7) 100%)' }
};

const MED_DATA={bronze:"data:image/webp;base64,",silver:"data:image/webp;base64,",gold:"data:image/webp;base64,",diamond:"data:image/webp;base64,",legend:"data:image/webp;base64,"};

const BG_DATA={bronze:"data:image/webp;base64,",silver:"data:image/webp;base64,",gold:"data:image/webp;base64,",diamond:"data:image/webp;base64,",legend:"data:image/webp;base64,"};

function buildBezel(rank){
  const m=(RANK_CONFIG[rank].metal)||['#444','#999','#ddd'];
  const cx=79,cy=79,bandR=58,n=12; let rivets='';
  for(let i=0;i<n;i++){ const a=(i/n)*Math.PI*2 - Math.PI/2; const x=cx+Math.cos(a)*bandR, y=cy+Math.sin(a)*bandR;
    rivets+=`<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="3.4" fill="url(#rvt)" stroke="${m[0]}" stroke-width="0.7"/><circle cx="${(x-0.9).toFixed(1)}" cy="${(y-0.9).toFixed(1)}" r="1.1" fill="${m[2]}" opacity="0.85"/>`;
  }
  return `<svg viewBox="0 0 158 158" width="158" height="158" xmlns="http://www.w3.org/2000/svg"><defs>`+
    `<linearGradient id="bnd" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="${m[2]}"/><stop offset="22%" stop-color="${m[1]}"/><stop offset="50%" stop-color="${m[0]}"/><stop offset="78%" stop-color="${m[1]}"/><stop offset="100%" stop-color="${m[2]}"/></linearGradient>`+
    `<radialGradient id="rvt" cx="36%" cy="36%" r="68%"><stop offset="0%" stop-color="${m[2]}"/><stop offset="55%" stop-color="${m[1]}"/><stop offset="100%" stop-color="${m[0]}"/></radialGradient></defs>`+
    `<circle cx="79" cy="79" r="64" fill="none" stroke="${m[0]}" stroke-width="2" opacity="0.45"/>`+
    `<circle cx="79" cy="79" r="58" fill="none" stroke="url(#bnd)" stroke-width="10"/>`+
    `<circle cx="79" cy="79" r="63" fill="none" stroke="${m[2]}" stroke-width="0.8" opacity="0.55"/>`+
    `<circle cx="79" cy="79" r="53" fill="none" stroke="${m[0]}" stroke-width="0.9" opacity="0.7"/>`+
    rivets+`</svg>`;
}

function buildInnerFrame(rank){
  const m=(RANK_CONFIG[rank].metal)||['#444','#999','#ddd'];
  return `<svg viewBox="0 0 320 560" width="100%" height="100%" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"><defs><g id="cnr">`+
    `<path d="M10,42 L10,18 Q10,10 18,10 L42,10" fill="none" stroke="${m[1]}" stroke-width="1.3" opacity="0.75"/>`+
    `<path d="M17,24 Q24,17 31,17" fill="none" stroke="${m[2]}" stroke-width="0.8" opacity="0.6"/>`+
    `<circle cx="14" cy="14" r="2.2" fill="none" stroke="${m[1]}" stroke-width="1"/>`+
    `<circle cx="14" cy="14" r="0.9" fill="${m[2]}"/>`+
    `</g></defs>`+
    `<rect x="7" y="7" width="306" height="546" rx="12" fill="none" stroke="${m[1]}" stroke-width="1" opacity="0.35"/>`+
    `<rect x="10" y="10" width="300" height="540" rx="10" fill="none" stroke="${m[2]}" stroke-width="0.5" opacity="0.18"/>`+
    `<use href="#cnr"/>`+
    `<use href="#cnr" transform="translate(320,0) scale(-1,1)"/>`+
    `<use href="#cnr" transform="translate(0,560) scale(1,-1)"/>`+
    `<use href="#cnr" transform="translate(320,560) scale(-1,-1)"/>`+
    `</svg>`;
}

const CARD_BG_MAP = {
  bronze: 'data:image/jpeg;base64,',
  silver: 'data:image/jpeg;base64,',
  gold: 'data:image/jpeg;base64,',
  diamond: 'data:image/jpeg;base64,',
  legend: 'data:image/jpeg;base64,',
};

function updateCardUI(rank){
  const bgEl=document.getElementById('cardEmptyBg'); if(bgEl&&CARD_BG_MAP[rank]) bgEl.src=CARD_BG_MAP[rank];  const cfg=RANK_CONFIG[rank]; const card=document.getElementById('theCard');
  card.className=`ww-card rank-${rank}`;
  const rib=document.getElementById('rankRibbon'); if(rib){ rib.textContent=cfg.label.split(' ').slice(1).join(' '); rib.style.color=cfg.labelColor; rib.style.borderTopColor=cfg.badgeColor; rib.style.borderBottomColor=cfg.badgeColor; }
  const mi=document.getElementById('medallionImg'); if(mi&&MED_DATA[rank]) mi.src=MED_DATA[rank];
  const bgi=document.getElementById('cardBackdrop'); if(bgi&&BG_DATA[rank]) bgi.src=BG_DATA[rank];
  const ifr=document.getElementById('cardInnerFrame'); if(ifr) ifr.innerHTML=buildInnerFrame(rank);
  document.getElementById('cardName').style.color=cfg.nameColor;
  const pf=document.getElementById('powerFill'); pf.style.background=cfg.powerGradient; document.getElementById('powerVal').style.color=cfg.powerColor;
  pf.style.width=Math.min(95,Math.round(cardPower/60))+'%';
  document.getElementById('cardOverlay').style.background=cfg.overlay;
  updateParticles(rank,cfg);
  document.querySelectorAll('.rank-btn').forEach(b=>{ b.classList.toggle('active', b.textContent.toLowerCase().includes(rank)); });
}

function updateParticles(rank,cfg){
  const container=document.getElementById('cardParticles'); container.innerHTML='';
  if(!cfg.particles||cfg.particles.length===0)return;
  const configs={ fire:{colors:['#FF2200','#FF6600','#FFAA00','#FF4400'],count:20,sizeMin:2,sizeMax:5,bottom:'0%',riseMin:150,riseMax:300}, gold:{colors:['#F0D080','#C9A84C','#FFEE88','#FFD700'],count:15,sizeMin:1,sizeMax:4,bottom:'20%',riseMin:100,riseMax:220}, crystal:{colors:['#c4b5fd','#8b5cf6','#e0d7ff','#a78bfa'],count:18,sizeMin:2,sizeMax:5,bottom:'10%',riseMin:120,riseMax:270}, silver:{colors:['#A8B4C0','#D0DDE8','#E2E8F0','#94A3B8'],count:10,sizeMin:1,sizeMax:3,bottom:'15%',riseMin:80,riseMax:180}, legend:{colors:['#F0D080','#FF4400','#FFEE00','#FF2200'],count:25,sizeMin:2,sizeMax:6,bottom:'0%',riseMin:180,riseMax:340} };
  cfg.particles.forEach(type=>{ const pc=configs[type]; if(!pc)return; for(let i=0;i<pc.count;i++){ const p=document.createElement('div'); p.className='cp'; const sz=pc.sizeMin+Math.random()*(pc.sizeMax-pc.sizeMin); const col=pc.colors[Math.floor(Math.random()*pc.colors.length)]; const rise=pc.riseMin+Math.random()*(pc.riseMax-pc.riseMin); p.style.cssText=`width:${sz}px;height:${sz}px;left:${Math.random()*100}%;bottom:${pc.bottom};background:${col};box-shadow:0 0 ${sz*2}px ${col};animation-duration:${2+Math.random()*4}s;animation-delay:${Math.random()*5}s;`; p.style.setProperty('--rise',`-${rise}px`); container.appendChild(p); } });
}

const styleEl=document.createElement('style');
styleEl.textContent=`@keyframes cpFloat { 0%{opacity:0;transform:translateY(0) scale(1);} 15%{opacity:1;} 85%{opacity:0.7;} 100%{opacity:0;transform:translateY(var(--rise,-280px)) scale(0.3);} }`;
document.head.appendChild(styleEl);

const fmt = n => (n==null ? '—' : Number(n).toLocaleString('en-US'));
const fmtAge = d => (d==null ? '—' : (d>=365 ? (d/365).toFixed(1)+'y' : d+'d'));
function setStatus(msg){ document.getElementById('forgeStatus').textContent=msg; }

function setProfileBadge(key, earned){
  const el=document.querySelector(`#profileBadges .card-badge[data-key="${key}"]`);
  if(!el)return;
  el.className = earned ? 'card-badge earned' : 'card-badge locked';
}

function applyData(d){
  setWalletSeed(d.address || WALLET);
  document.getElementById('statTx').textContent        = fmt(d.txCount);
  document.getElementById('statAge').textContent       = fmtAge(d.ageDays);
  document.getElementById('statContracts').textContent = fmt(d.uniqueContracts);
  document.getElementById('statTokens').textContent    = fmt(d.realTokenCount);
  document.getElementById('statGas').textContent       = (d.gasBurnedUsd!=null) ? '$'+fmt(d.gasBurnedUsd) : '—';
  document.getElementById('netWorthVal').textContent   = (d.netWorth!=null) ? '$'+fmt(d.netWorth) : '—';

  // Wallet Power = el que ya calculo el backend (scoring.js), no se recalcula aqui
  cardPower = d.walletPower || 0;
  document.getElementById('powerVal').textContent = fmt(cardPower);

  // Profile badges from real data
  const pb = d.profileBadges || {};
  setProfileBadge('OG', pb.OG); setProfileBadge('Explorer', pb.Explorer);
  setProfileBadge('Collector', pb.Collector); setProfileBadge('Builder', pb.Builder);

  // Combat badges stay locked until real combat exists; fresh card = 0W 0L
  document.getElementById('footerWL').textContent = '0W · 0L';

  // fresh forge = bronze; re-render art with this wallet's seed
  currentRank = 'bronze';
  updateCardUI('bronze');
}


// ── BADGE TOOLTIPS ──
const tip=document.createElement('div'); tip.className='ww-tip';
tip.innerHTML='<div class="ww-tip-name"></div><div class="ww-tip-desc"></div>';
document.body.appendChild(tip);
const tipName=tip.querySelector('.ww-tip-name'), tipDesc=tip.querySelector('.ww-tip-desc');
function showTip(el){
  const n=el.getAttribute('data-name'); if(!n)return;
  tipName.textContent=n; tipDesc.textContent=el.getAttribute('data-desc')||'';
  tip.classList.toggle('locked', el.classList.contains('locked'));
  const r=el.getBoundingClientRect();
  tip.style.left=(r.left+r.width/2)+'px';
  tip.style.top=(r.top-8)+'px';
  requestAnimationFrame(()=>tip.classList.add('show'));
}
function hideTip(){ tip.classList.remove('show'); }
document.querySelectorAll('.card-badge[data-name], .card-stat[data-name]').forEach(el=>{
  el.addEventListener('mouseenter',()=>showTip(el));
  el.addEventListener('mouseleave',hideTip);
});

// ── 3D TILT ──
const card=document.getElementById('theCard');
const glare=document.getElementById('cardGlare');
const mStage=document.querySelector('.medallion-stage');
const innerFrameEl=document.getElementById('cardInnerFrame');
card.addEventListener('mousemove', e=>{ const rect=card.getBoundingClientRect(); const x=(e.clientX-rect.left)/rect.width-0.5; const y=(e.clientY-rect.top)/rect.height-0.5; card.style.transform=`perspective(800px) rotateY(${x*18}deg) rotateX(${-y*18}deg) scale(1.04)`; if(glare) glare.style.background=`radial-gradient(circle 130px at ${((x+0.5)*100).toFixed(1)}% ${((y+0.5)*100).toFixed(1)}%, rgba(255,255,255,0.55), rgba(255,255,255,0.12) 38%, transparent 68%)`; if(mStage) mStage.style.transform=`translate(${(-x*20).toFixed(1)}px, ${(-y*20).toFixed(1)}px)`; if(innerFrameEl) innerFrameEl.style.transform=`translate(${(-x*9).toFixed(1)}px, ${(-y*9).toFixed(1)}px)`; const _bg=document.getElementById('cardBackdrop'); if(_bg) _bg.style.transform=`translate(-50%,-50%) translate(${(x*9).toFixed(1)}px, ${(y*9).toFixed(1)}px)`; });
card.addEventListener('mouseleave', ()=>{ card.style.transform=''; card.style.transition='transform 0.6s cubic-bezier(0.23,1,0.32,1)'; if(mStage) mStage.style.transform=''; if(innerFrameEl) innerFrameEl.style.transform=''; const _bg=document.getElementById('cardBackdrop'); if(_bg) _bg.style.transform='translate(-50%,-50%)'; });
card.addEventListener('mouseenter', ()=>{ card.style.transition='transform 0.1s ease'; });

// ── SWORD-CLASH SPARK TRAIL ──
const SPARK_COLORS=['#FFF1B0','#FFD86A','#FF9A3C','#FFE8A0','#ffffff'];
function spawnSpark(x,y){
  const angle=Math.random()*Math.PI*2;
  const speed=16+Math.random()*42;
  const dx=Math.cos(angle)*speed;
  const dy=Math.sin(angle)*speed+16;            // gravity bias
  const rot=Math.atan2(dy,dx)+Math.PI/2;
  const len=4+Math.random()*9;
  const col=SPARK_COLORS[(Math.random()*SPARK_COLORS.length)|0];
  const s=document.createElement('div');
  s.style.cssText=`position:fixed;left:${x}px;top:${y}px;width:2px;height:${len.toFixed(1)}px;background:linear-gradient(180deg,${col},transparent);box-shadow:0 0 6px ${col},0 0 12px rgba(255,170,70,0.5);border-radius:2px;pointer-events:none;z-index:99998;`;
  document.body.appendChild(s);
  s.animate([
    {transform:`translate(-50%,-50%) rotate(${rot}rad) scale(1)`,opacity:1},
    {transform:`translate(calc(-50% + ${dx.toFixed(0)}px), calc(-50% + ${dy.toFixed(0)}px)) rotate(${rot}rad) scale(0.3)`,opacity:0}
  ],{duration:360+Math.random()*280,easing:'cubic-bezier(0.15,0.7,0.4,1)'}).onfinish=()=>s.remove();
}
let _lx=null,_ly=null;
card.addEventListener('mousemove', e=>{
  const cx=e.clientX, cy=e.clientY;
  if(_lx===null){_lx=cx;_ly=cy;}
  if(Math.hypot(cx-_lx,cy-_ly)>5){
    const n=1+(Math.random()*2|0);
    for(let i=0;i<n;i++) spawnSpark(cx,cy);
    if(Math.random()<0.12){ for(let i=0;i<8;i++) spawnSpark(cx,cy); }  // clash burst
    _lx=cx; _ly=cy;
  }
});

// ── INIT ──
updateCardUI('bronze');


// ══ FORGING ══
let forgedData = null;

function startForging() {
  document.getElementById('forgingScreen').classList.add('open');
  const sparks = document.getElementById('forgeSparks');
  for(let i=0; i<12; i++){
    const s = document.createElement('div'); s.className = 'spark';
    const angle = (i/12)*Math.PI*2, dist = 60 + Math.random()*40;
    s.style.left = '50%'; s.style.top = '50%';
    s.style.setProperty('--sx', Math.cos(angle)*dist + 'px');
    s.style.setProperty('--sy', Math.sin(angle)*dist + 'px');
    s.style.animationDuration = (0.8 + Math.random()*0.8) + 's';
    s.style.animationDelay = (Math.random()*1.5) + 's';
    s.style.animationIterationCount = 'infinite';
    sparks.appendChild(s);
  }
  const msgs = ['Connecting to Base Network...','Reading on-chain history...','Calculating Wallet Power...','Analyzing gas & contracts...','Forging your Combat Card...','Almost ready...'];
  const steps = ['step1','step2','step3','step4','step5'];
  const timings = [0,800,1800,2800,3800,4600];
  const stepTimings = [400,1200,2200,3200,4200];
  let pct = 0;
  const barInterval = setInterval(() => {
    pct = Math.min(pct + Math.random()*3, 92);
    document.getElementById('forgeBar').style.width = pct + '%';
    document.getElementById('forgePct').textContent = Math.floor(pct) + '%';
  }, 120);
  msgs.forEach((msg,i) => setTimeout(() => document.getElementById('forgeMsg').textContent = msg, timings[i]));
  stepTimings.forEach((time,i) => setTimeout(() => {
    if(i>0) document.getElementById(steps[i-1]).className = 'forge-step done';
    document.getElementById(steps[i]).className = 'forge-step active';
  }, time));

  // llamada real al backend, en paralelo con la animacion
  fetch(`/api/wallet/${walletAddress}`)
    .then(r => r.json())
    .then(d => {
      if (d.error) {
        document.getElementById('forgeMsg').textContent = 'Error reading your wallet: ' + d.error;
        clearInterval(barInterval);
        return;
      }
      forgedData = d;
    })
    .catch(err => {
      console.error('forge fetch error:', err);
      document.getElementById('forgeMsg').textContent = 'Could not reach the backend. Is server.js running?';
      clearInterval(barInterval);
    });

  // esperar a que termine tanto la animacion (5.5s) como el fetch real
  const finish = () => {
    if (!forgedData) { setTimeout(finish, 200); return; }
    clearInterval(barInterval);
    document.getElementById('forgeBar').style.width = '100%';
    document.getElementById('forgePct').textContent = '100%';
    document.getElementById(steps[4]).className = 'forge-step done';
    document.getElementById('forgeMsg').textContent = 'Your Combat Card is ready!';
    setTimeout(() => {
      document.getElementById('forgingScreen').classList.remove('open');
      showScreen4(forgedData);
    }, 1200);
  };
  setTimeout(finish, 5500);
}

// ══ PANTALLA 4 (personalizar + carta real) ══
function showScreen4(data) {
  document.getElementById('screen4').classList.add('open');
  applyData(data);
  updateCardName('');
}
function updateCardName(val) {
  document.getElementById('cardName').textContent = val.trim().toUpperCase() || 'YOUR NAME';
}
function selectTitle(el, title) {
  document.querySelectorAll('.s4-title-opt').forEach(o => o.classList.remove('selected'));
  el.classList.add('selected');
  document.getElementById('cardTitle').textContent = title;
}
async function enterArena() {
  const nameInput = document.getElementById('s4NameInput');
  const name = nameInput.value.trim();
  if (!name || name.length < 3) {
    nameInput.focus();
    nameInput.style.borderColor = '#CC2200';
    setTimeout(() => nameInput.style.borderColor = 'rgba(201,168,76,0.25)', 1500);
    return;
  }
  const btn = document.querySelector('.s4-btn');
  const btnText = document.querySelector('.s4-btn-text');
  const originalText = btnText.textContent;
  btnText.textContent = 'Forging identity...';
  btn.style.pointerEvents = 'none';
  try {
    const res = await fetch('/api/combatant', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + sessionToken,
      },
      body: JSON.stringify({ address: walletAddress, name }),
    });
    const data = await res.json();
    if (!res.ok || !data.ok) {
      btnText.textContent = originalText;
      btn.style.pointerEvents = '';
      if (res.status === 409) {
        nameInput.style.borderColor = '#CC2200';
        nameInput.focus();
        alert('That combatant name is already taken — try another one.');
      } else {
        alert('Could not forge your combatant: ' + (data.error || 'unknown error'));
      }
      return;
    }
    document.getElementById('screen4').classList.remove('open');
    myCombatantId = data.card && data.card.id ? data.card.id : null;
    setTimeout(() => showArena(name.toUpperCase()), 400);
  } catch (err) {
    console.error('enterArena error:', err);
    btnText.textContent = originalText;
    btn.style.pointerEvents = '';
    alert('Something went wrong registering your combatant. Please try again.');
  }
}

// ══ ARENA ══
function showArena(name) {
  document.getElementById('screen5').classList.add('open');
  document.getElementById('arenaName').textContent = name;
  myArenaName = name;
  const medSrc = document.getElementById('medallionImg').src;
  const avatarImg = `<img src="${medSrc}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;display:block;">`;
  myAvatarImgHtml = avatarImg;
  document.getElementById('arenaAvatar').innerHTML = avatarImg;
  document.getElementById('arenaTitle').textContent = document.getElementById('cardTitle').textContent;
  updateArenaSidebarStats();
  const arenaEc = document.getElementById('arenaEmbers');
  if (arenaEc && !arenaEc.dataset.filled) {
    arenaEc.dataset.filled = '1';
    for (let i = 0; i < 18; i++) {
      const e = document.createElement('div'); e.className = 'ember';
      const sz = 1.5 + Math.random()*2.5 + 'px';
      e.style.width = sz; e.style.height = sz;
      e.style.left = Math.random()*100 + '%';
      e.style.animationDuration = (8 + Math.random()*12) + 's';
      e.style.animationDelay = (Math.random()*12) + 's';
      e.style.setProperty('--dx', (Math.random()*80-40) + 'px');
      arenaEc.appendChild(e);
    }
  }
}
function updateArenaSidebarStats() {
  if (!forgedData) return;
  const d = forgedData;
  document.getElementById('arenaStatTx').textContent = fmt(d.txCount);
  document.getElementById('arenaStatAge').textContent = fmtAge(d.ageDays);
  document.getElementById('arenaStatContracts').textContent = fmt(d.uniqueContracts);
  document.getElementById('arenaStatTokens').textContent = fmt(d.realTokenCount);
  document.getElementById('arenaStatGas').textContent = (d.gasBurnedUsd!=null) ? '$'+fmt(d.gasBurnedUsd) : '—';
  const power = d.walletPower || 0;
  document.getElementById('arenaPowerFill').style.width = Math.min(100, power/100) + '%';
}
let cardMountOriginalParent = null;
const WILDCARD_INFO = {
  veterans_gambit:   { icon:'⏳', name:"Veteran's Gambit",  req:'Wallet age ≥ 1 year',      check: d => (d.ageDays||0) >= 365 },
  multichain_strike: { icon:'🔗', name:'Multichain Strike', req:'≥ 15 tokens held',         check: d => (d.realTokenCount||0) >= 15 },
  builders_override: { icon:'🔨', name:"Builder's Override", req:'≥ 50 unique contracts',   check: d => (d.uniqueContracts||0) >= 50 },
  giant_killer:       { icon:'💀', name:'Giant Killer',      req:'Always available',        check: () => true },
};
let bpCurrentOrder = ['tx','age','contracts','diversification','gas'];
let bpSelectedWildcard = null;

async function openBattlePlan() {
  if (!myCombatantId) { alert('Register your combatant first.'); return; }
  document.getElementById('bpStatus').textContent = '';
  try {
    const res = await fetch(`/api/battle-plan/${myCombatantId}`);
    const plan = await res.json();
    if (plan && Array.isArray(plan.card_order) && plan.card_order.length === 5) {
      bpCurrentOrder = plan.card_order.slice();
      bpSelectedWildcard = plan.wildcard || null;
    }
  } catch (err) {
    console.error('openBattlePlan fetch error:', err);
  }
  renderBpOrderList();
  renderBpWildcardGrid();
  document.getElementById('battlePlanModal').classList.add('open');
}
function closeBattlePlan() {
  document.getElementById('battlePlanModal').classList.remove('open');
}
function renderBpOrderList() {
  const list = document.getElementById('bpOrderList');
  list.innerHTML = bpCurrentOrder.map((stat, i) => `
    <div class="bp-order-row">
      <div class="bp-order-num">${i+1}</div>
      <div class="bp-order-label">${STAT_LABELS[stat] || stat}</div>
      <div class="bp-order-arrows">
        <button class="bp-arrow-btn" onclick="moveBpStat(${i},-1)" ${i===0?'disabled':''}>▲</button>
        <button class="bp-arrow-btn" onclick="moveBpStat(${i},1)" ${i===bpCurrentOrder.length-1?'disabled':''}>▼</button>
      </div>
    </div>`).join('');
}
function moveBpStat(i, dir) {
  const j = i + dir;
  if (j < 0 || j >= bpCurrentOrder.length) return;
  [bpCurrentOrder[i], bpCurrentOrder[j]] = [bpCurrentOrder[j], bpCurrentOrder[i]];
  renderBpOrderList();
}
function renderBpWildcardGrid() {
  const grid = document.getElementById('bpWildcardGrid');
  const d = forgedData || {};
  grid.innerHTML = Object.keys(WILDCARD_INFO).map(key => {
    const info = WILDCARD_INFO[key];
    const unlocked = info.check(d);
    const selected = bpSelectedWildcard === key;
    return `<div class="bp-wc-opt${unlocked?'':' locked'}${selected?' selected':''}" onclick="${unlocked ? `selectBpWildcard('${key}')` : ''}">
      <div class="bp-wc-icon">${info.icon}</div>
      <div class="bp-wc-name">${info.name}</div>
      <div class="bp-wc-req">${unlocked ? (selected ? 'Selected' : 'Unlocked') : '🔒 ' + info.req}</div>
    </div>`;
  }).join('');
}
function selectBpWildcard(key) {
  bpSelectedWildcard = (bpSelectedWildcard === key) ? null : key;
  renderBpWildcardGrid();
}
async function saveBattlePlan() {
  const status = document.getElementById('bpStatus');
  status.style.color = '#4ade80';
  status.textContent = 'Saving...';
  try {
    const res = await fetch(`/api/battle-plan/${myCombatantId}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + sessionToken },
      body: JSON.stringify({ cardOrder: bpCurrentOrder, wildcard: bpSelectedWildcard }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'unknown error');
    status.textContent = 'Battle Plan saved ✓';
    setTimeout(() => closeBattlePlan(), 900);
  } catch (err) {
    console.error('saveBattlePlan error:', err);
    status.style.color = '#ff6b4a';
    status.textContent = 'Could not save: ' + err.message;
  }
}

const COMING_SOON_INFO = {
  shop: { icon: '🛍', title: 'The Forge Shop', desc: 'Spend Forge Points on card frames, medallion effects, victory auras and exclusive titles. Always cosmetic — never stats. Your combat power always comes from your real wallet.' },
  mint: { icon: '💠', title: 'Mint Your Combat Card', desc: 'Capture your card as an on-chain NFT snapshot — a permanent trophy of this exact moment. Mint anytime, or catch a special frame by minting right when you hit a new rank.' },
};
function openComingSoon(type) {
  const info = COMING_SOON_INFO[type] || COMING_SOON_INFO.shop;
  document.getElementById('soonIcon').textContent = info.icon;
  document.getElementById('soonTitle').textContent = info.title;
  document.getElementById('soonDesc').textContent = info.desc;
  document.getElementById('comingSoonModal').classList.add('open');
}
function closeComingSoon() {
  document.getElementById('comingSoonModal').classList.remove('open');
}

function openCardView() {
  const mount = document.getElementById('cardMount');
  if (!cardMountOriginalParent) cardMountOriginalParent = mount.parentNode;
  document.getElementById('cardViewBody').appendChild(mount);
  document.getElementById('cardViewModal').classList.add('open');
}
function closeCardView() {
  const mount = document.getElementById('cardMount');
  if (cardMountOriginalParent) cardMountOriginalParent.appendChild(mount);
  document.getElementById('cardViewModal').classList.remove('open');
}
function switchTab(tab) {
  ['challenge','random','pending','leaderboard'].forEach(t => {
    document.getElementById('tab-'+t).style.display = t===tab ? 'block' : 'none';
    document.getElementById('nav-'+t).classList.toggle('active', t===tab);
  });
  if (tab === 'leaderboard') loadLeaderboard();
  if (tab === 'pending') loadChallengeHistory();
}
let myArenaName = '', myAvatarImgHtml = '', myCombatantId = null;
let challengeHistoryLoaded = false;
async function loadChallengeHistory() {
  const list = document.getElementById('challengesList');
  if (!myCombatantId) {
    list.innerHTML = '<div style="text-align:center; padding:20px; color:rgba(168,180,192,0.5); font-size:0.6rem;">Could not identify your combatant yet.</div>';
    return;
  }
  if (challengeHistoryLoaded) return;
  try {
    const res = await fetch(`/api/matches/history/${myCombatantId}?limit=20`);
    const rows = await res.json();
    if (!Array.isArray(rows)) throw new Error(rows.error || 'respuesta inesperada');
    challengeHistoryLoaded = true;
    renderChallengeHistory(rows);
  } catch (err) {
    console.error('loadChallengeHistory error:', err);
    list.innerHTML = '<div style="text-align:center; padding:20px; color:rgba(204,34,0,0.6); font-size:0.6rem;">Could not load your battle history.</div>';
  }
}
function timeAgo(iso) {
  const diffMs = Date.now() - new Date(iso).getTime();
  const mins = Math.floor(diffMs/60000);
  if (mins < 1) return 'just now';
  if (mins < 60) return mins + 'min ago';
  const hrs = Math.floor(mins/60);
  if (hrs < 24) return hrs + 'h ago';
  return Math.floor(hrs/24) + 'd ago';
}
function renderChallengeHistory(rows) {
  const list = document.getElementById('challengesList');
  if (!rows.length) { list.innerHTML = '<div style="text-align:center; padding:20px; color:rgba(168,180,192,0.5); font-size:0.65rem;">No battles yet. Challenge someone!</div>'; return; }
  list.innerHTML = rows.map(r => {
    const attackerName = (r.attacker && r.attacker.combatant_name) || 'Unknown';
    const defenderName = (r.defender && r.defender.combatant_name) || 'Unknown';
    const iWasAttacker = r.attacker_id === myCombatantId;
    const oppName = iWasAttacker ? defenderName : attackerName;
    const iWon = r.winner_id === myCombatantId;
    const dir = iWasAttacker ? 'You challenged' : 'Challenged you';
    return `<div class="challenge-item">
      <div class="challenge-item-avatar">${iWon ? '🏆' : '💀'}</div>
      <div class="challenge-item-info"><div class="challenge-item-name">${oppName.toUpperCase()}</div><div class="challenge-item-meta">${dir} · ${r.score || ''} · ${timeAgo(r.created_at)}</div></div>
      <div style="font-size:0.55rem; letter-spacing:0.15em; color:${iWon ? '#4ade80' : '#ff6b4a'}; text-transform:uppercase;">${iWon ? 'Victory' : 'Defeat'}</div>
    </div>`;
  }).join('');
}
let leaderboardLoaded = false;
async function loadLeaderboard() {
  if (leaderboardLoaded) return;
  const list = document.getElementById('leaderboardList');
  try {
    const res = await fetch('/api/leaderboard/season?limit=20');
    const data = await res.json();
    if (!Array.isArray(data)) throw new Error(data.error || 'respuesta inesperada');
    leaderboardLoaded = true;
    renderLeaderboard(data);
  } catch (err) {
    console.error('loadLeaderboard error:', err);
    list.innerHTML = '<div style="text-align:center; padding:20px; color:rgba(204,34,0,0.6); font-size:0.6rem; letter-spacing:0.1em;">Could not load the leaderboard. Is the server running?</div>';
  }
}
function lbAvatarHtml(name) {
  const letter = (name || '?').trim().charAt(0).toUpperCase();
  return `<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-family:'Cinzel Decorative',serif;font-weight:900;color:#F0D080;background:radial-gradient(circle,#2a1a08,#0a0a0a);">${letter}</div>`;
}
function renderLeaderboard(rows) {
  const list = document.getElementById('leaderboardList');
  if (!rows.length) { list.innerHTML = '<div style="text-align:center; padding:20px; color:rgba(168,180,192,0.5); font-size:0.65rem;">No combatants forged yet. Be the first!</div>'; return; }
  const iAmIn = rows.some(r => (r.combatant_name || '').toLowerCase() === myArenaName.toLowerCase());
  let html = rows.map((r, i) => {
    const rankPos = i + 1;
    const isMe = (r.combatant_name || '').toLowerCase() === myArenaName.toLowerCase();
    const avatar = isMe && myAvatarImgHtml ? myAvatarImgHtml : lbAvatarHtml(r.combatant_name);
    return `<div class="lb-row${isMe ? ' you' : ''}">
      <div class="lb-rank${rankPos<=3?' top':''}">${rankPos}</div>
      <div class="lb-avatar">${avatar}</div>
      <div class="lb-info"><div class="lb-name">${(r.combatant_name||'?').toUpperCase()}</div><div class="lb-title-lb">${(r.rank||'bronze').toUpperCase()} · ${r.wins||0} Wins</div></div>
      <div style="text-align:right"><div class="lb-power">${fmt(r.wallet_power||0)}</div><div class="lb-wins">${r.wins||0}W · ${r.losses||0}L</div></div>
    </div>`;
  }).join('');
  if (!iAmIn && myArenaName) {
    html += `<div class="lb-row you"><div class="lb-rank" style="color:#C9A84C">—</div><div class="lb-avatar" id="lbYourAvatar">${myAvatarImgHtml || '⚔'}</div><div class="lb-info"><div class="lb-name">${myArenaName.toUpperCase()}</div><div class="lb-title-lb">Not ranked yet</div></div><div style="text-align:right"><div class="lb-power">${fmt((forgedData&&forgedData.walletPower)||0)}</div><div class="lb-wins">0W · 0L</div></div></div>`;
  }
  list.innerHTML = html;
}
const STAT_LABELS = { tx:'Transactions', age:'Wallet Age', contracts:'Contracts', diversification:'Token Diversity', gas:'Gas Burned' };
let combatData = null;   // { winner, score, rounds } de /api/combat
let combatRoundIdx = 0;
let combatMyName = '', combatOppName = '';

async function launchChallengeAgainst(defenderName) {
  const myName = document.getElementById('arenaName').textContent;
  try {
    const res = await fetch('/api/combat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + sessionToken },
      body: JSON.stringify({ attackerName: myName, defenderName }),
    });
    const data = await res.json();
    if (!res.ok || !data.ok) {
      alert('No se pudo lanzar el reto: ' + (data.error || 'combatiente no encontrado. Comprueba que ha forjado su carta y su nombre exacto.'));
      return;
    }
    combatData = data;
    combatMyName = myName;
    combatOppName = defenderName;
    launchCombat(myName, defenderName);
  } catch (err) {
    console.error('launchChallengeAgainst error:', err);
    alert('Error de conexión al lanzar el reto.');
  }
}
async function sendChallenge() {
  const input = document.getElementById('challengeInput').value.trim();
  if (!input) { document.getElementById('challengeInput').style.borderColor='#CC2200'; setTimeout(()=>document.getElementById('challengeInput').style.borderColor='rgba(201,168,76,0.2)',1500); return; }
  document.getElementById('challengeInput').value = '';
  await launchChallengeAgainst(input);
}
let randomOpponentName = null;
async function startRandomDuel() {
  const btn = document.getElementById('randomDuelBtn');
  btn.innerHTML = '<span>🔍</span> Searching for opponent...';
  btn.disabled = true;
  try {
    const res = await fetch('/api/leaderboard/season?limit=100');
    const rows = await res.json();
    if (!Array.isArray(rows)) throw new Error('respuesta inesperada');
    const candidates = rows.filter(r => (r.combatant_name||'').toLowerCase() !== myArenaName.toLowerCase());
    if (!candidates.length) {
      alert('No hay otros combatientes forjados todavía. Invita a alguien a forjar su carta primero.');
      return;
    }
    const opp = candidates[Math.floor(Math.random()*candidates.length)];
    randomOpponentName = opp.combatant_name;
    document.getElementById('randomOppName').textContent = opp.combatant_name.toUpperCase();
    document.getElementById('randomOppMeta').textContent = `${(opp.rank||'bronze').toUpperCase()} · Power: ${fmt(opp.wallet_power||0)}`;
    document.getElementById('randomMatchPanel').style.display = 'block';
  } catch (err) {
    console.error('startRandomDuel error:', err);
    alert('No se pudo buscar rival. ¿Está el servidor corriendo?');
  } finally {
    btn.innerHTML = '<span style="font-size:1.2rem">⚔</span>Find an Opponent<span style="font-size:1.2rem">⚔</span>';
    btn.disabled = false;
  }
}
async function acceptRandomDuel() {
  if (!randomOpponentName) return;
  document.getElementById('randomMatchPanel').style.display = 'none';
  await launchChallengeAgainst(randomOpponentName);
}

function medallionSeal(name) {
  return `<div class="med-seal">${(name||'?').trim().charAt(0).toUpperCase()}</div>`;
}
function spawnClashSparks(color) {
  const arena = document.getElementById('combatArena');
  const rect = arena.getBoundingClientRect();
  const cx = rect.width/2, cy = rect.height/2;
  for (let i = 0; i < 14; i++) {
    const s = document.createElement('div');
    s.className = 'clash-spark';
    const angle = Math.random()*Math.PI*2, dist = 40 + Math.random()*90;
    s.style.left = cx + 'px'; s.style.top = cy + 'px';
    s.style.background = color;
    s.style.boxShadow = `0 0 6px ${color}`;
    s.style.setProperty('--sx', Math.cos(angle)*dist + 'px');
    s.style.setProperty('--sy', Math.sin(angle)*dist + 'px');
    arena.appendChild(s);
    setTimeout(() => s.remove(), 650);
  }
}
function triggerClash(winnerSide) {
  const color = winnerSide === 'a' ? '#F0D080' : '#ff9d8a';
  document.getElementById('screen6').classList.add('shake');
  setTimeout(() => document.getElementById('screen6').classList.remove('shake'), 460);
  const flash = document.getElementById('impactFlash');
  flash.classList.toggle('opp-flash', winnerSide === 'b');
  flash.style.animation = 'none'; void flash.offsetWidth; flash.style.animation = 'flashIn 0.4s ease';
  const lightning = document.getElementById('lightningLayer');
  lightning.classList.remove('strike'); void lightning.offsetWidth; lightning.classList.add('strike');
  spawnClashSparks(color);
}

let cardMountOriginalParentBattle = null;
let oppLossCount = 0, meLossCount = 0;
const STAT_TO_CARD_ID = { tx:'statTx', age:'statAge', contracts:'statContracts', diversification:'statTokens', gas:'statGas' };

function medallionSeal(name) {
  return `<div class="med-seal">${(name||'?').trim().charAt(0).toUpperCase()}</div>`;
}
function spawnClashSparks(color) {
  const arena = document.getElementById('combatArena');
  const rect = arena.getBoundingClientRect();
  const cx = rect.width/2, cy = rect.height/2;
  for (let i = 0; i < 14; i++) {
    const s = document.createElement('div');
    s.className = 'clash-spark';
    const angle = Math.random()*Math.PI*2, dist = 40 + Math.random()*90;
    s.style.left = cx + 'px'; s.style.top = cy + 'px';
    s.style.background = color;
    s.style.boxShadow = `0 0 6px ${color}`;
    s.style.setProperty('--sx', Math.cos(angle)*dist + 'px');
    s.style.setProperty('--sy', Math.sin(angle)*dist + 'px');
    arena.appendChild(s);
    setTimeout(() => s.remove(), 650);
  }
}
function triggerClash(winnerSide) {
  const color = winnerSide === 'a' ? '#F0D080' : '#ff9d8a';
  document.getElementById('screen6').classList.add('shake');
  setTimeout(() => document.getElementById('screen6').classList.remove('shake'), 460);
  const flash = document.getElementById('impactFlash');
  flash.classList.toggle('opp-flash', winnerSide === 'b');
  flash.style.animation = 'none'; void flash.offsetWidth; flash.style.animation = 'flashIn 0.4s ease';
  spawnClashSparks(color);
}
function showDramaBanner(title, sub, danger) {
  const b = document.getElementById('dramaBanner');
  document.getElementById('dramaTitle').textContent = title;
  document.getElementById('dramaTitle').className = 'drama-title' + (danger ? ' danger' : '');
  document.getElementById('dramaSub').textContent = sub || '';
  b.classList.remove('show'); void b.offsetWidth; b.classList.add('show');
}
function addTickerLine(html) {
  const t = document.getElementById('battleTicker');
  const line = document.createElement('div');
  line.className = 'ticker-line';
  line.innerHTML = html;
  t.appendChild(line);
  while (t.children.length > 4) t.removeChild(t.firstChild);
}
function applyCrackStage(side, lossCount) {
  const overlay = document.getElementById(side === 'me' ? 'myCrackOverlay' : 'oppCrackOverlay');
  overlay.className = 'card-crack-overlay' + (lossCount >= 1 ? ' stage-1' : '') + (lossCount >= 2 ? ' stage-2' : '') + (lossCount >= 3 ? ' stage-3' : '');
}

function launchCombat(myName, oppName) {
  document.getElementById('introName1').textContent = myName.toUpperCase();
  document.getElementById('introName2').textContent = oppName.toUpperCase();
  const myPower = (forgedData && forgedData.walletPower) || 0;
  document.getElementById('introRank1').textContent = 'Power ' + fmt(myPower);
  document.getElementById('introRank2').textContent = 'Combatant';
  document.getElementById('fightName1').textContent = myName.toUpperCase();
  document.getElementById('fightName2').textContent = oppName.toUpperCase();
  document.getElementById('fightTitle1').textContent = myName;
  document.getElementById('fightTitle2').textContent = oppName;

  const medSrc = document.getElementById('medallionImg') ? document.getElementById('medallionImg').src : '';
  const meFaceHtml = medSrc ? `<img src="${medSrc}">` : '⚔';
  document.getElementById('medallionMeFace').innerHTML = meFaceHtml;
  document.getElementById('medallionOppFace').innerHTML = medallionSeal(oppName);

  // mover la carta REAL a la pantalla de combate (mismo mecanismo que "Ver mi carta")
  const mount = document.getElementById('cardMount');
  if (mount) {
    if (!cardMountOriginalParentBattle) cardMountOriginalParentBattle = cardMountOriginalParent || mount.parentNode;
    document.getElementById('myCardSlot').appendChild(mount);
  }
  document.getElementById('scSeal').textContent = (oppName||'?').trim().charAt(0).toUpperCase();
  document.getElementById('scName').textContent = oppName.toUpperCase();
  document.querySelectorAll('.sc-stat-row').forEach(row => { row.classList.remove('revealed','hit-highlight'); row.querySelector('.sc-val').textContent = '?'; });
  document.getElementById('oppShadowCard').style.filter = '';
  document.getElementById('battleTicker').innerHTML = '';
  document.getElementById('myCrackOverlay').className = 'card-crack-overlay';
  document.getElementById('oppCrackOverlay').className = 'card-crack-overlay';
  document.getElementById('myCardWrap').classList.remove('victory-aura');
  document.getElementById('oppCardWrap').classList.remove('victory-aura');
  meLossCount = 0; oppLossCount = 0;

  document.getElementById('combatIntro').style.display = 'flex';
  document.getElementById('combatUI').style.display = 'none';
  document.getElementById('combatResult').style.display = 'none';
  document.getElementById('introBtn').style.display = 'block';
  combatRoundIdx = 0;
  document.getElementById('score1Num').textContent = '0';
  document.getElementById('score2Num').textContent = '0';
  ['dot0','dot1','dot2','dot3','dot4'].forEach(id => { const el = document.getElementById(id); el.className = 'cdot'; el.style.display = 'inline-block'; });
  document.getElementById('screen6').classList.add('open');
  const combatEc = document.getElementById('combatEmbers');
  if (combatEc && !combatEc.dataset.filled) {
    combatEc.dataset.filled = '1';
    for (let i = 0; i < 26; i++) {
      const e = document.createElement('div'); e.className = 'ember';
      const sz = 1.5 + Math.random()*2.5 + 'px';
      e.style.width = sz; e.style.height = sz;
      e.style.left = Math.random()*100 + '%';
      e.style.animationDuration = (7 + Math.random()*10) + 's';
      e.style.animationDelay = (Math.random()*10) + 's';
      e.style.setProperty('--dx', (Math.random()*80-40) + 'px');
      combatEc.appendChild(e);
    }
  }
}

function startCombat() {
  document.getElementById('combatIntro').style.display = 'none';
  document.getElementById('introBtn').style.display = 'none';
  document.getElementById('combatUI').style.display = 'flex';
  renderRound(0);
}

function renderRound(idx) {
  if (!combatData || !combatData.rounds[idx]) return;
  const r = combatData.rounds[idx];
  const total = combatData.rounds.length;

  // marcador ANTES de aplicar esta ronda, para detectar match point
  let priorA = 0, priorB = 0;
  for (let i = 0; i < idx; i++) { if (combatData.rounds[i].winner === 'a') priorA++; else priorB++; }
  if ((priorA === 2 || priorB === 2) && priorA !== 3 && priorB !== 3) {
    showDramaBanner('MATCH POINT', priorA === 2 ? (combatMyName + ' can close it out').toUpperCase() : (combatOppName + ' can close it out').toUpperCase(), priorB === 2);
  }

  document.getElementById('roundLabel').textContent = `ROUND ${idx+1} OF ${total}`;
  document.getElementById('roundTitle').textContent = (STAT_LABELS[r.stat] || r.stat).toUpperCase();
  document.getElementById('barLabel1').textContent = fmt(r.a);
  document.getElementById('barLabel2').textContent = fmt(r.b);
  const maxVal = Math.max(r.a, r.b, 1);
  document.getElementById('bar1').style.width = Math.round((r.a/maxVal)*100) + '%';
  document.getElementById('bar1').style.height = '18px';
  document.getElementById('bar2').style.width = Math.round((r.b/maxVal)*100) + '%';
  document.getElementById('bar2').style.height = '18px';

  const badge = document.getElementById('roundResultBadge');
  const winnerName = r.winner === 'a' ? combatMyName : combatOppName;
  badge.className = 'round-result-badge ' + (r.winner === 'a' ? 'me-win' : 'opp-win');
  badge.textContent = (r.wildcard ? '🃏 ' + r.wildcard.replace(/_/g,' ') + ' -- ' : '') + winnerName.toUpperCase() + ' WINS THE ROUND';

  for (let i = 0; i < 5; i++) {
    const dot = document.getElementById('dot'+i);
    if (!dot) continue;
    dot.style.display = i < total ? 'inline-block' : 'none';
    if (i >= total) continue;
    if (i < idx) dot.className = 'cdot ' + (combatData.rounds[i].winner === 'a' ? 'me-dot' : 'opp-dot');
    else if (i === idx) dot.className = 'cdot active';
    else dot.className = 'cdot';
  }
  let winsA = 0, winsB = 0;
  for (let i = 0; i <= idx; i++) { if (combatData.rounds[i].winner === 'a') winsA++; else winsB++; }
  document.getElementById('score1Num').textContent = winsA;
  document.getElementById('score2Num').textContent = winsB;
  const nextBtn = document.getElementById('combatNextBtn');
  nextBtn.style.display = 'block';
  nextBtn.textContent = (idx === total - 1) ? 'SEE RESULT ›' : 'NEXT ROUND ›';

  // revelar el stat del rival en su carta sombra + resaltar el stat comparado en ambas cartas
  const scRow = document.querySelector('.sc-stat-row[data-stat="' + r.stat + '"]');
  if (scRow) { scRow.classList.add('revealed'); scRow.querySelector('.sc-val').textContent = fmt(r.b); scRow.classList.remove('hit-highlight'); void scRow.offsetWidth; scRow.classList.add('hit-highlight'); }
  const cardStatId = STAT_TO_CARD_ID[r.stat];
  if (cardStatId) {
    const cardStatVal = document.getElementById(cardStatId);
    const wrapperEl = cardStatVal ? cardStatVal.closest('.card-stat') : null;
    if (wrapperEl) { wrapperEl.classList.remove('hit-highlight'); void wrapperEl.offsetWidth; wrapperEl.classList.add('hit-highlight'); }
  }

  // anuncio de comodin
  if (r.wildcard) {
    showDramaBanner((r.wildcard.replace(/_/g,' ')).toUpperCase() + ' TRIGGERED', winnerName.toUpperCase() + ' TURNS THE TIDE', r.winner === 'b');
  }

  // brillo / grieta segun quien gana esta ronda
  if (r.winner === 'a') {
    document.getElementById('myCardWrap').classList.remove('glow-pulse'); void document.getElementById('myCardWrap').offsetWidth; document.getElementById('myCardWrap').classList.add('glow-pulse');
    oppLossCount++; applyCrackStage('opp', oppLossCount);
  } else {
    document.getElementById('oppCardWrap').classList.remove('glow-pulse'); void document.getElementById('oppCardWrap').offsetWidth; document.getElementById('oppCardWrap').classList.add('glow-pulse');
    meLossCount++; applyCrackStage('me', meLossCount);
  }

  addTickerLine(`Round ${idx+1}: <b>${winnerName.toUpperCase()}</b> wins ${(STAT_LABELS[r.stat]||r.stat)} (${fmt(r.a)} vs ${fmt(r.b)})`);

  triggerClash(r.winner);
  setTimeout(() => {
    const wonDot = document.getElementById('dot'+idx);
    if (wonDot) wonDot.className = 'cdot ' + (r.winner === 'a' ? 'me-dot' : 'opp-dot');
  }, 350);
}

function nextRound() {
  combatRoundIdx++;
  if (combatRoundIdx >= combatData.rounds.length) {
    showCombatResult();
  } else {
    renderRound(combatRoundIdx);
  }
}

const FLAME_SVG = `<svg viewBox="0 0 100 100" width="88" height="88"><defs><linearGradient id="flameGrad" x1="0" y1="1" x2="0" y2="0"><stop offset="0%" stop-color="#8B1A00"/><stop offset="40%" stop-color="#CC4400"/><stop offset="72%" stop-color="#F0A030"/><stop offset="100%" stop-color="#FFEFA0"/></linearGradient></defs><path d="M50,97 C22,84 14,58 28,36 C31,52 39,53 39,42 C39,24 53,14 49,1 C69,15 79,39 69,58 C84,54 84,74 64,84 C69,69 59,67 54,74 C49,84 59,88 50,97 Z" fill="url(#flameGrad)"/></svg>`;
const BROKEN_SWORD_SVG = `<svg viewBox="0 0 100 140" width="70" height="98"><g fill="#8a8f98" stroke="#2a2d31" stroke-width="1.5"><polygon points="50,2 60,44 50,56 40,44"/><polygon points="45,63 55,63 58,88 42,88" transform="rotate(9 50 75)"/></g><rect x="43" y="94" width="14" height="9" fill="#4a4d52" stroke="#2a2d31" stroke-width="1"/><rect x="33" y="103" width="34" height="9" rx="2" fill="#6b4f10" stroke="#3a2a10" stroke-width="1"/><rect x="46" y="112" width="8" height="24" fill="#3a2a10"/></svg>`;

function spawnFlameParticles() {
  const layer = document.getElementById('resultFxLayer');
  for (let i = 0; i < 22; i++) {
    const p = document.createElement('div');
    p.className = 'flame-particle';
    const sz = 4 + Math.random()*8;
    p.style.width = sz + 'px'; p.style.height = sz + 'px';
    p.style.left = (35 + Math.random()*30) + '%';
    const hue = Math.random() < 0.5 ? '#F0A030' : '#CC4400';
    p.style.background = `radial-gradient(circle, #FFEFA0, ${hue})`;
    p.style.boxShadow = `0 0 8px ${hue}`;
    p.style.animationDuration = (1.2 + Math.random()*1.4) + 's';
    p.style.animationDelay = (Math.random()*1.2) + 's';
    layer.appendChild(p);
  }
}
function spawnBloodDrips() {
  const layer = document.getElementById('resultFxLayer');
  for (let i = 0; i < 10; i++) {
    const d = document.createElement('div');
    d.className = 'blood-drip';
    d.style.left = (10 + Math.random()*80) + '%';
    d.style.height = (30 + Math.random()*70) + 'px';
    d.style.animationDuration = (1.6 + Math.random()*1.2) + 's';
    d.style.animationDelay = (Math.random()*0.8) + 's';
    layer.appendChild(d);
  }
}

function showCombatResult() {
  // el combat-ui se queda visible detras (cartas con su brillo/grietas), el panel de
  // resultado es translucido encima -- no lo ocultamos
  document.getElementById('combatResult').style.display = 'flex';
  document.getElementById('combatNextBtn').style.display = 'none';
  document.getElementById('resultFxLayer').innerHTML = '';
  const iWon = combatData.winner === combatMyName || combatData.winner.toLowerCase() === combatMyName.toLowerCase();
  document.getElementById('resultWinnerName').textContent = combatData.winner.toUpperCase();
  document.getElementById('resultWinnerName').className = 'result-winner-name ' + (iWon ? 'me' : 'opp');
  document.getElementById('resultOutcomeLabel').textContent = iWon ? 'WINS THE BATTLE' : 'FALLS IN DEFEAT';

  const iconWrap = document.getElementById('resultIconWrap');
  iconWrap.className = 'result-icon-wrap' + (iWon ? '' : ' lose');
  iconWrap.innerHTML = (iWon ? '<div class="icon-rays"></div>' : '') + (iWon ? FLAME_SVG : BROKEN_SWORD_SVG);
  if (iWon) spawnFlameParticles(); else spawnBloodDrips();

  const [w, l] = combatData.score.split('-');
  document.getElementById('resultScore1').textContent = w;
  document.getElementById('resultScore2').textContent = l;
  document.getElementById(iWon ? 'myCardWrap' : 'oppCardWrap').classList.add('victory-aura');
}

function shareResult(platform) {
  if (!combatData) return;
  const text = `⚔ ${combatData.winner.toUpperCase()} won ${combatData.score} in WalletWars! Your wallet. Your weapon.`;
  const url = platform === 'x'
    ? 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(text)
    : 'https://warpcast.com/~/compose?text=' + encodeURIComponent(text);
  window.open(url, '_blank');
}

function resetCombat() {
  document.getElementById('screen6').classList.remove('open');
  // devolver la carta real a su sitio original
  const mount = document.getElementById('cardMount');
  if (mount && cardMountOriginalParentBattle) cardMountOriginalParentBattle.appendChild(mount);
  document.getElementById('myCardWrap').classList.remove('glow-pulse','victory-aura');
  document.getElementById('oppCardWrap').classList.remove('glow-pulse','victory-aura');
  combatData = null;
  combatRoundIdx = 0;
  leaderboardLoaded = false;
  challengeHistoryLoaded = false;
}

// ══ CANVAS RAYOS ══
const canvas = document.createElement('canvas');
canvas.id = 'bgCanvas';
canvas.style.cssText = 'position:fixed;inset:0;z-index:0;pointer-events:none;';
document.getElementById('bgCanvas').replaceWith(canvas);
const ctx = canvas.getContext('2d');
let W, H, t = 0;
function resize() { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }
resize(); window.addEventListener('resize', resize);
function draw() {
  ctx.clearRect(0,0,W,H);
  const cx=W/2, cy=H/2, pulse=0.5+Math.sin(t*0.007)*0.5;
  for(let i=0;i<14;i++){
    const angle=(i/14)*Math.PI*2+t*0.0003, spread=0.04+Math.sin(t*0.004+i)*0.012;
    const len=Math.max(W,H)*1.3, alpha=(0.01+Math.sin(t*0.003+i*0.7)*0.005)*pulse;
    const x2=cx+Math.cos(angle)*len, y2=cy+Math.sin(angle)*len;
    const x1a=cx+Math.cos(angle-spread)*6, y1a=cy+Math.sin(angle-spread)*6;
    const x1b=cx+Math.cos(angle+spread)*6, y1b=cy+Math.sin(angle+spread)*6;
    const ray=ctx.createLinearGradient(cx,cy,x2,y2);
    ray.addColorStop(0,'rgba(201,168,76,'+(alpha*1.5)+')');
    ray.addColorStop(0.4,'rgba(201,168,76,'+alpha+')');
    ray.addColorStop(1,'rgba(201,168,76,0)');
    ctx.beginPath(); ctx.moveTo(x1a,y1a); ctx.lineTo(x2,y2); ctx.lineTo(x1b,y1b);
    ctx.closePath(); ctx.fillStyle=ray; ctx.fill();
  }
  t++; requestAnimationFrame(draw);
}
draw();

// ══ EMBERS ══
const ec = document.getElementById('embers');
for(let i=0;i<40;i++){
  const e=document.createElement('div'); e.className='ember';
  const sz=1.5+Math.random()*2.5+'px';
  e.style.width=sz; e.style.height=sz;
  e.style.left=Math.random()*100+'vw';
  e.style.animationDuration=(9+Math.random()*14)+'s';
  e.style.animationDelay=(Math.random()*15)+'s';
  e.style.setProperty('--dx',(Math.random()*80-40)+'px');
  ec.appendChild(e);
}
</script>

<!-- PANTALLA 6 — COMBAT (rediseño épico) -->
<div class="screen6" id="screen6">
  <div class="combat-bg"></div>
  <div class="combat-bg-image"></div>
  <div class="combat-spotlight"></div>
  <div class="combat-floor-glow"></div>
  <div class="combat-embers" id="combatEmbers"></div>
  <div class="combat-bg-glow"></div>
  <div class="impact-flash" id="impactFlash"></div>
  <div class="lightning-layer" id="lightningLayer">
    <svg viewBox="0 0 100 100" preserveAspectRatio="none">
      <polyline points="10,50 35,42 42,58 58,38 65,55 90,50" fill="none" stroke="#F0D080" stroke-width="0.8" stroke-linejoin="round" style="filter:drop-shadow(0 0 4px #F0D080)"/>
    </svg>
  </div>

  <!-- INTRO -->
  <div class="combat-intro" id="combatIntro">
    <div class="intro-card-wrap left">
      <div class="duel-medallion me" id="medallionMe">
        <div class="med-ring"></div>
        <div class="med-face" id="medallionMeFace">⚔</div>
      </div>
      <div class="intro-card-name" id="introName1">SHADOW WALKER</div>
      <div class="intro-card-rank" id="introRank1">🥇 Gold · Power 7,240</div>
    </div>
    <div class="intro-vs">VS</div>
    <div class="intro-card-wrap right">
      <div class="duel-medallion opp" id="medallionOpp">
        <div class="med-ring"></div>
        <div class="med-face" id="medallionOppFace"><div class="med-seal">?</div></div>
      </div>
      <div class="intro-card-name" id="introName2">VOID HUNTER</div>
      <div class="intro-card-rank" id="introRank2">Combatant</div>
    </div>
  </div>
  <button class="intro-btn" id="introBtn" onclick="startCombat()">⚔ &nbsp; START COMBAT &nbsp; ⚔</button>

  <!-- COMBAT UI -->
  <div class="combat-ui" id="combatUI">
    <div class="combat-top">
      <div class="fighter-header">
        <div class="fighter-hname me" id="fightName1">SHADOW WALKER</div>
        <div class="fighter-htitle" id="fightTitle1">Shadow Walker</div>
      </div>
      <div class="combat-score-center">
        <div class="score-box me" id="score1"><div class="sb-corner tl"></div><div class="sb-corner tr"></div><div class="sb-corner bl"></div><div class="sb-corner br"></div><div class="sb-gem"></div><span id="score1Num">0</span></div>
        <div class="score-divider">—</div>
        <div class="score-box opp" id="score2"><div class="sb-corner tl"></div><div class="sb-corner tr"></div><div class="sb-corner bl"></div><div class="sb-corner br"></div><div class="sb-gem"></div><span id="score2Num">0</span></div>
      </div>
      <div class="fighter-header right">
        <div class="fighter-hname opp" id="fightName2">VOID HUNTER</div>
        <div class="fighter-htitle" id="fightTitle2">Void Hunter</div>
      </div>
    </div>

    <div class="combat-arena" id="combatArena">
      <div class="fighter-col card-col">
        <div class="card-fx-wrap" id="myCardWrap">
          <div id="myCardSlot"></div>
          <div class="card-crack-overlay" id="myCrackOverlay"><svg viewBox="0 0 320 560" xmlns="http://www.w3.org/2000/svg">
        <g class="crack-line crack-1" stroke="#000" stroke-width="1.4" fill="none" opacity="0">
          <path d="M60,0 L75,90 L50,160 L90,230"/><path d="M75,90 L110,120"/>
        </g>
        <g class="crack-line crack-2" stroke="#000" stroke-width="1.4" fill="none" opacity="0">
          <path d="M300,40 L250,140 L280,220 L230,300"/><path d="M250,140 L210,160"/>
        </g>
        <g class="crack-line crack-3" stroke="#000" stroke-width="1.6" fill="none" opacity="0">
          <path d="M160,560 L180,460 L140,380 L170,300 L130,220"/><path d="M180,460 L230,440"/>
        </g>
      </svg></div>
        </div>
      </div>
      <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:8px;max-width:420px">
        <div class="round-label" id="roundLabel">ROUND 1 OF 5</div>
        <div class="round-title-big" id="roundTitle">TRANSACTIONS</div>
        <div class="bars-wrap" id="barsWrap">
          <div class="bar-row">
            <div class="bar-meta"><span id="barLabel1">0</span><span>Transactions</span><span id="barLabel2">0</span></div>
            <div class="bar-track" style="display:flex;gap:2px">
              <div style="flex:1;background:rgba(255,255,255,0.04);border-radius:4px 0 0 4px;overflow:hidden;"><div class="bar-fill me" id="bar1" style="float:right"></div></div>
              <div style="flex:1;background:rgba(255,255,255,0.04);border-radius:0 4px 4px 0;overflow:hidden;"><div class="bar-fill opp" id="bar2"></div></div>
            </div>
          </div>
        </div>
        <div class="round-result-badge" id="roundResultBadge"></div>
        <div class="combat-dots" id="combatDots">
          <div class="cdot" id="dot0">⚔</div>
          <div class="cdot" id="dot1">⚔</div>
          <div class="cdot" id="dot2">⚔</div>
          <div class="cdot" id="dot3">⚔</div>
          <div class="cdot" id="dot4">⚔</div>
        </div>
        <div class="battle-ticker" id="battleTicker"></div>
      </div>
      <div class="fighter-col card-col">
        <div class="card-fx-wrap" id="oppCardWrap">
          <div class="shadow-card" id="oppShadowCard">
            <div class="sc-medallion"><div class="sc-seal" id="scSeal">?</div></div>
            <div class="sc-name" id="scName">OPPONENT</div>
            <div class="sc-sub">Combatant</div>
            <div class="sc-stats">
              <div class="sc-stat-row" data-stat="tx"><span>Txs</span><span class="sc-val">?</span></div>
              <div class="sc-stat-row" data-stat="age"><span>Age</span><span class="sc-val">?</span></div>
              <div class="sc-stat-row" data-stat="contracts"><span>Contracts</span><span class="sc-val">?</span></div>
              <div class="sc-stat-row" data-stat="diversification"><span>Tokens</span><span class="sc-val">?</span></div>
              <div class="sc-stat-row" data-stat="gas"><span>Gas</span><span class="sc-val">?</span></div>
            </div>
          </div>
          <div class="card-crack-overlay" id="oppCrackOverlay"><svg viewBox="0 0 320 560" xmlns="http://www.w3.org/2000/svg">
        <g class="crack-line crack-1" stroke="#000" stroke-width="1.4" fill="none" opacity="0">
          <path d="M60,0 L75,90 L50,160 L90,230"/><path d="M75,90 L110,120"/>
        </g>
        <g class="crack-line crack-2" stroke="#000" stroke-width="1.4" fill="none" opacity="0">
          <path d="M300,40 L250,140 L280,220 L230,300"/><path d="M250,140 L210,160"/>
        </g>
        <g class="crack-line crack-3" stroke="#000" stroke-width="1.6" fill="none" opacity="0">
          <path d="M160,560 L180,460 L140,380 L170,300 L130,220"/><path d="M180,460 L230,440"/>
        </g>
      </svg></div>
        </div>
      </div>
      <div class="drama-banner" id="dramaBanner">
        <div class="drama-title" id="dramaTitle">MATCH POINT</div>
        <div class="drama-sub" id="dramaSub"></div>
      </div>
    </div>
    <button class="combat-next-btn" id="combatNextBtn" onclick="nextRound()">NEXT ROUND ›</button>
  </div>

  <!-- RESULT -->
  <div class="combat-result" id="combatResult">
    <div class="result-fx-layer" id="resultFxLayer"></div>
    <div class="result-icon-wrap" id="resultIconWrap"></div>
    <div class="result-winner-name me" id="resultWinnerName">SHADOW WALKER</div>
    <div class="result-label" id="resultOutcomeLabel">WINS THE BATTLE</div>
    <div class="result-score">
      <div class="result-score-num me" id="resultScore1">3</div>
      <div class="result-score-dash">—</div>
      <div class="result-score-num opp" id="resultScore2">2</div>
    </div>
    <div class="result-btns">
      <button class="result-share-btn x" onclick="shareResult('x')">✕ Share on X</button>
      <button class="result-share-btn fc" onclick="shareResult('farcaster')">⬣ Share on Farcaster</button>
      <button class="result-share-btn again" onclick="resetCombat()">⚔ Fight Again</button>
    </div>
  </div>
</div>

</body>
</html>