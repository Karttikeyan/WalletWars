<!DOCTYPE html>
<html lang="en" translate="no">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>WalletWars — Your Wallet. Your Weapon.</title>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Cinzel+Decorative:wght@700;900&family=IM+Fell+English:ital@1&display=swap" rel="stylesheet">
  <style>
    :root {
      --gold:       #C9A84C;
      --gold-light: #F0D080;
      --gold-dark:  #8B6914;
      --red-deep:   #3a0a08;
      --black:      #080808;
      --silver:     #A8B4C0;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: var(--black);
      font-family: 'Cinzel', serif;
      min-height: 100vh;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: crosshair;
    }
    #bgCanvas { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
    .bg-axes {
      position: fixed; inset: 0; z-index: 1;
      background: url('bg-axes.jpg') center/35% no-repeat;
      opacity: 0.75;
      pointer-events: none;
    }
    .vignette {
      position: fixed; inset: 0; z-index: 2; pointer-events: none;
      background:
        radial-gradient(ellipse 70% 60% at 50% 50%, rgba(8,8,8,0) 20%, rgba(8,8,8,0.7) 100%),
        radial-gradient(ellipse 55% 50% at 50% 50%, rgba(58,10,8,0.45) 0%, rgba(26,4,4,0.35) 35%, transparent 70%);
    }
    .frame { position: fixed; inset: 0; z-index: 3; pointer-events: none; }
    .frame-h { position: absolute; left: 90px; right: 90px; height: 1px; background: linear-gradient(to right, transparent, rgba(201,168,76,0.3), var(--gold), rgba(201,168,76,0.3), transparent); }
    .frame-h.top    { top: 24px; }
    .frame-h.bottom { bottom: 24px; }
    .frame-v { position: absolute; top: 90px; bottom: 90px; width: 1px; background: linear-gradient(to bottom, transparent, rgba(201,168,76,0.3), var(--gold), rgba(201,168,76,0.3), transparent); }
    .frame-v.left  { left: 24px; }
    .frame-v.right { right: 24px; }
    .corner { position: absolute; width: 90px; height: 90px; }
    .corner svg { width: 100%; height: 100%; }
    .corner.tl { top: 0; left: 0; }
    .corner.tr { top: 0; right: 0; transform: scaleX(-1); }
    .corner.bl { bottom: 0; left: 0; transform: scaleY(-1); }
    .corner.br { bottom: 0; right: 0; transform: scale(-1); }
    .embers { position: fixed; inset: 0; z-index: 3; pointer-events: none; overflow: hidden; }
    .ember { position: absolute; border-radius: 50%; background: radial-gradient(circle, #F0D080, #C9A84C, transparent); opacity: 0; animation: ember-rise linear infinite; }
    @keyframes ember-rise {
      0%   { transform: translateY(100vh) translateX(0) scale(1); opacity: 0; }
      5%   { opacity: 0.7; }
      80%  { opacity: 0.1; }
      100% { transform: translateY(-15vh) translateX(var(--dx)) scale(0.2); opacity: 0; }
    }
    .main {
      position: relative; z-index: 10;
      display: flex; align-items: center; justify-content: center;
      gap: 5vw; padding: 0 60px;
      animation: fadeIn 1.8s ease forwards;
      width: 100%; max-width: 1200px;
    }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

    /* ── COL TEXTO ── */
    .col-text { display: flex; flex-direction: column; align-items: flex-start; text-align: left; flex: 1; }
    .eyebrow { font-size: 0.58rem; letter-spacing: 0.55em; color: rgba(240,208,128,0.7); margin-bottom: 1.4rem; display: flex; align-items: center; gap: 10px; text-shadow: 0 0 8px rgba(201,168,76,0.6); }
    .eyebrow-line { width: 30px; height: 1px; background: rgba(201,168,76,0.5); }
    .logo { font-family: 'Cinzel Decorative', serif; font-weight: 900; font-size: clamp(3rem, 6vw, 5.5rem); line-height: 0.9; letter-spacing: 0.03em; background: linear-gradient(175deg, #fff5cc 0%, #F0D080 15%, #C9A84C 35%, #8B6914 55%, #C9A84C 72%, #F0D080 85%, #fff5cc 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 1.2rem; }
    .divider { display: flex; align-items: center; gap: 10px; margin-bottom: 1.2rem; width: 100%; max-width: 340px; }
    .divider-line { flex: 1; height: 1px; background: linear-gradient(to right, var(--gold-dark), var(--gold), var(--gold-dark)); opacity: 0.6; }
    .divider-diamond { width: 7px; height: 7px; background: var(--gold); transform: rotate(45deg); box-shadow: 0 0 6px rgba(201,168,76,0.6); flex-shrink: 0; }
    .tagline { font-family: 'IM Fell English', serif; font-style: italic; font-size: clamp(0.9rem, 1.6vw, 1.15rem); color: var(--silver); letter-spacing: 0.06em; margin-bottom: 2.5rem; opacity: 0.9; }
    .btn-arena { position: relative; background: none; border: none; cursor: pointer; padding: 0; font-family: 'Cinzel', serif; margin-bottom: 1.4rem; }
    .btn-inner { display: flex; align-items: center; justify-content: center; gap: 12px; padding: 1rem 2.8rem; background: linear-gradient(135deg, #6b4f10 0%, #C9A84C 25%, #F0D080 50%, #C9A84C 75%, #6b4f10 100%); clip-path: polygon(18px 0%, calc(100% - 18px) 0%, 100% 50%, calc(100% - 18px) 100%, 18px 100%, 0% 50%); transition: all 0.3s ease; min-width: 280px; }
    .btn-arena:hover .btn-inner { background: linear-gradient(135deg, #8B6914 0%, #F0D080 35%, #fffacc 50%, #F0D080 65%, #8B6914 100%); box-shadow: 0 0 50px rgba(201,168,76,0.55); transform: scale(1.03); }
    .btn-text { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.42em; color: #0a0700; text-transform: uppercase; }
    .btn-icon { font-size: 0.9rem; color: rgba(10,7,0,0.55); }
    .sub-cta { font-size: 0.56rem; letter-spacing: 0.45em; color: rgba(240,208,128,0.8); text-transform: uppercase; display: flex; align-items: center; gap: 12px; text-shadow: 0 0 10px rgba(201,168,76,0.8); }
    .sub-cta::before, .sub-cta::after { content: ''; width: 28px; height: 1px; background: rgba(201,168,76,0.5); }

    /* ── COMBAT CARD ── */
    .col-card { flex-shrink: 0; perspective: 1000px; }
    .combat-card { width: 280px; background: linear-gradient(160deg, #1c0c08 0%, #0e0e12 55%, #080810 100%); border-radius: 14px; padding: 20px 18px 22px; position: relative; animation: card-float 5s ease-in-out infinite; box-shadow: 0 0 0 1px #6b4f10, 0 0 0 3px #0e0e12, 0 0 0 5px var(--gold), 0 0 50px rgba(201,168,76,0.3), 0 0 100px rgba(201,168,76,0.1), inset 0 0 60px rgba(0,0,0,0.5); }
    @keyframes card-float { 0%,100% { transform: rotateY(-5deg) rotateX(2deg) translateY(0px); } 50% { transform: rotateY(5deg) rotateX(-2deg) translateY(-14px); } }
    .card-corner { position: absolute; width: 20px; height: 20px; border-color: var(--gold); border-style: solid; opacity: 0.6; }
    .card-corner.tl { top: 9px; left: 9px; border-width: 1.5px 0 0 1.5px; }
    .card-corner.tr { top: 9px; right: 9px; border-width: 1.5px 1.5px 0 0; }
    .card-corner.bl { bottom: 9px; left: 9px; border-width: 0 0 1.5px 1.5px; }
    .card-corner.br { bottom: 9px; right: 9px; border-width: 0 1.5px 1.5px 0; }
    .card-shimmer { position: absolute; inset: 0; border-radius: 14px; background: linear-gradient(135deg, transparent 30%, rgba(255,245,180,0.04) 50%, transparent 70%); animation: shimmer-move 4s ease-in-out infinite; pointer-events: none; }
    @keyframes shimmer-move { 0%,100% { opacity: 0.3; } 50% { opacity: 1; } }
    .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .card-rank { font-size: 0.48rem; letter-spacing: 0.25em; color: var(--gold-dark); text-transform: uppercase; }
    .card-badge { font-size: 0.5rem; letter-spacing: 0.15em; color: var(--gold); border: 1px solid rgba(201,168,76,0.3); padding: 2px 7px; border-radius: 2px; }
    .card-hline { height: 1px; margin: 0 0 12px; background: linear-gradient(to right, transparent, rgba(201,168,76,0.2), transparent); }
    .card-avatar-wrap { display: flex; justify-content: center; margin-bottom: 10px; position: relative; }
    .card-avatar { width: 72px; height: 72px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #2a1a0a, #0e0a04); border: 2px solid rgba(201,168,76,0.5); display: flex; align-items: center; justify-content: center; font-size: 2rem; box-shadow: 0 0 20px rgba(201,168,76,0.25), inset 0 0 20px rgba(0,0,0,0.5); }
    .card-avatar-ring { position: absolute; inset: -5px; border-radius: 50%; border: 1px solid rgba(201,168,76,0.15); }
    .card-name { text-align: center; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.25em; color: var(--gold-light); margin-bottom: 2px; text-transform: uppercase; }
    .card-sub { text-align: center; font-size: 0.48rem; letter-spacing: 0.2em; color: rgba(168,180,192,0.4); margin-bottom: 12px; font-style: italic; }
    .card-power-wrap { margin-bottom: 12px; }
    .card-power-label { display: flex; justify-content: space-between; font-size: 0.46rem; letter-spacing: 0.18em; color: rgba(168,180,192,0.5); margin-bottom: 4px; text-transform: uppercase; }
    .card-power-bar { height: 4px; background: rgba(255,255,255,0.05); border-radius: 2px; border: 1px solid rgba(201,168,76,0.12); overflow: hidden; }
    .card-power-fill { height: 100%; width: 72%; background: linear-gradient(to right, var(--gold-dark), var(--gold), var(--gold-light)); border-radius: 2px; box-shadow: 0 0 8px rgba(201,168,76,0.5); }
    .card-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 12px; }
    .stat { background: rgba(255,255,255,0.025); border: 1px solid rgba(201,168,76,0.1); border-radius: 4px; padding: 6px 8px; }
    .stat-label { font-size: 0.4rem; letter-spacing: 0.18em; color: rgba(168,180,192,0.4); text-transform: uppercase; margin-bottom: 2px; }
    .stat-value { font-size: 0.68rem; font-weight: 700; color: var(--gold-light); letter-spacing: 0.05em; }
    .card-badges { display: flex; justify-content: center; gap: 8px; margin-bottom: 14px; }
    .badge { width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; border: 1px solid rgba(201,168,76,0.3); background: rgba(201,168,76,0.05); }
    .badge.locked { filter: grayscale(1); opacity: 0.2; }
    .card-btn { width: 100%; padding: 9px; background: linear-gradient(135deg, #6b4f10, #C9A84C, #F0D080, #C9A84C, #6b4f10); border: none; border-radius: 4px; cursor: pointer; font-family: 'Cinzel', serif; font-size: 0.55rem; font-weight: 700; letter-spacing: 0.35em; color: #0a0700; text-transform: uppercase; transition: all 0.3s; }
    .card-btn:hover { box-shadow: 0 0 20px rgba(201,168,76,0.5); transform: scale(1.02); }

    .season-tag { position: fixed; bottom: 36px; left: 50%; transform: translateX(-50%); z-index: 10; font-size: 0.52rem; letter-spacing: 0.45em; color: rgba(240,208,128,0.6); text-transform: uppercase; white-space: nowrap; text-shadow: 0 0 10px rgba(201,168,76,0.6); }

    /* ══ MODAL ══ */
    .modal-overlay { position: fixed; inset: 0; z-index: 100; background: rgba(8,4,4,0.88); display: none; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.35s ease; }
    .modal-overlay.open { display: flex; opacity: 1; backdrop-filter: blur(6px); }
    .modal { position: relative; width: 420px; background: linear-gradient(160deg, #1c0c08 0%, #0e0e12 60%, #080810 100%); border-radius: 16px; padding: 36px 32px 32px; box-shadow: 0 0 0 1px #6b4f10, 0 0 0 3px #0e0e12, 0 0 0 4px #C9A84C, 0 0 60px rgba(201,168,76,0.25); transform: translateY(20px) scale(0.97); transition: transform 0.35s ease; }
    .modal-overlay.open .modal { transform: translateY(0) scale(1); }
    .modal-corner { position: absolute; width: 20px; height: 20px; border-color: var(--gold); border-style: solid; opacity: 0.6; }
    .modal-corner.tl { top: 9px; left: 9px; border-width: 1.5px 0 0 1.5px; }
    .modal-corner.tr { top: 9px; right: 9px; border-width: 1.5px 1.5px 0 0; }
    .modal-corner.bl { bottom: 9px; left: 9px; border-width: 0 0 1.5px 1.5px; }
    .modal-corner.br { bottom: 9px; right: 9px; border-width: 0 1.5px 1.5px 0; }
    .modal-close { position: absolute; top: 14px; right: 16px; background: none; border: none; cursor: pointer; color: rgba(201,168,76,0.4); font-size: 1.1rem; transition: color 0.2s; font-family: 'Cinzel', serif; }
    .modal-close:hover { color: var(--gold); }
    .modal-icon { text-align: center; font-size: 2rem; margin-bottom: 0.6rem; filter: drop-shadow(0 0 10px rgba(201,168,76,0.5)); }
    .modal-title { font-family: 'Cinzel', serif; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.4em; color: var(--gold-light); text-align: center; text-transform: uppercase; margin-bottom: 0.4rem; }
    .modal-sub { font-size: 0.55rem; letter-spacing: 0.25em; color: rgba(168,180,192,0.45); text-align: center; text-transform: uppercase; margin-bottom: 1.8rem; }
    .modal-divider { height: 1px; margin-bottom: 1.6rem; background: linear-gradient(to right, transparent, rgba(201,168,76,0.3), transparent); }
    .wallet-option { display: flex; align-items: center; gap: 16px; padding: 14px 18px; background: rgba(255,255,255,0.025); border: 1px solid rgba(201,168,76,0.12); border-radius: 8px; cursor: pointer; margin-bottom: 10px; transition: all 0.25s ease; width: 100%; font-family: 'Cinzel', serif; }
    .wallet-option:hover { background: rgba(201,168,76,0.08); border-color: rgba(201,168,76,0.4); box-shadow: 0 0 20px rgba(201,168,76,0.15); transform: translateX(4px); }
    .wallet-logo { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; flex-shrink: 0; }
    .wallet-logo.metamask { background: linear-gradient(135deg, #ff6b35, #e2761b); }
    .wallet-logo.coinbase { background: linear-gradient(135deg, #0052ff, #0a3bd4); }
    .wallet-logo.walletconnect { background: linear-gradient(135deg, #3b99fc, #0078ff); }
    .wallet-info { flex: 1; text-align: left; }
    .wallet-name { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.2em; color: var(--gold-light); text-transform: uppercase; margin-bottom: 2px; }
    .wallet-desc { font-size: 0.5rem; letter-spacing: 0.15em; color: rgba(168,180,192,0.4); font-family: 'Cinzel', serif; }
    .wallet-arrow { color: rgba(201,168,76,0.3); font-size: 0.8rem; transition: all 0.25s; }
    .wallet-option:hover .wallet-arrow { color: var(--gold); transform: translateX(3px); }
    .modal-footer { margin-top: 1.4rem; text-align: center; font-size: 0.5rem; letter-spacing: 0.25em; color: rgba(168,180,192,0.25); text-transform: uppercase; }

    /* ══ FORGING ══ */
    .forging-screen { position: fixed; inset: 0; z-index: 200; background: rgba(8,4,4,0.96); display: none; flex-direction: column; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.4s ease; }
    .forging-screen.open { display: flex; opacity: 1; }
    .forge-ring-wrap { position: relative; width: 160px; height: 160px; margin-bottom: 2.5rem; }
    .forge-ring { position: absolute; inset: 0; border-radius: 50%; border: 2px solid transparent; border-top-color: #F0D080; border-right-color: #C9A84C; animation: ring-spin 1.2s linear infinite; }
    .forge-ring.r2 { inset: 12px; border-top-color: transparent; border-bottom-color: #C9A84C; border-left-color: #8B6914; animation-duration: 1.8s; animation-direction: reverse; }
    .forge-ring.r3 { inset: 24px; border-top-color: #F0D080; border-right-color: transparent; border-bottom-color: transparent; border-left-color: transparent; animation-duration: 0.9s; }
    @keyframes ring-spin { to { transform: rotate(360deg); } }
    .forge-icon { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 2.8rem; animation: forge-pulse 1.5s ease-in-out infinite; filter: drop-shadow(0 0 16px rgba(201,168,76,0.6)); }
    @keyframes forge-pulse { 0%,100% { transform: scale(1); opacity: 0.8; } 50% { transform: scale(1.12); opacity: 1; } }
    .forge-sparks { position: absolute; inset: -20px; pointer-events: none; }
    .spark { position: absolute; width: 3px; height: 3px; background: #F0D080; border-radius: 50%; animation: spark-fly linear infinite; }
    @keyframes spark-fly { 0% { transform: translate(0,0) scale(1); opacity: 1; } 100% { transform: translate(var(--sx), var(--sy)) scale(0); opacity: 0; } }
    .forge-title { font-family: 'Cinzel Decorative', serif; font-size: 1.4rem; font-weight: 700; letter-spacing: 0.25em; color: #C9A84C; text-transform: uppercase; margin-bottom: 0.6rem; text-shadow: 0 0 20px rgba(201,168,76,0.5); }
    .forge-msg { font-family: 'Cinzel', serif; font-size: 0.65rem; letter-spacing: 0.3em; color: rgba(168,180,192,0.7); text-transform: uppercase; margin-bottom: 2rem; min-height: 1.2rem; transition: opacity 0.4s ease; }
    .forge-bar-wrap { width: 320px; margin-bottom: 0.6rem; }
    .forge-bar-label { display: flex; justify-content: space-between; font-size: 0.5rem; letter-spacing: 0.2em; color: rgba(201,168,76,0.5); margin-bottom: 6px; text-transform: uppercase; }
    .forge-bar-bg { height: 4px; background: rgba(255,255,255,0.05); border-radius: 2px; overflow: hidden; border: 1px solid rgba(201,168,76,0.15); }
    .forge-bar-fill { height: 100%; width: 0%; background: linear-gradient(to right, #8B6914, #C9A84C, #F0D080); border-radius: 2px; box-shadow: 0 0 8px rgba(201,168,76,0.6); transition: width 0.3s ease; }
    .forge-steps { margin-top: 1.5rem; display: flex; flex-direction: column; gap: 8px; width: 320px; }
    .forge-step { display: flex; align-items: center; gap: 10px; font-size: 0.52rem; letter-spacing: 0.2em; color: rgba(168,180,192,0.3); text-transform: uppercase; transition: color 0.3s ease; }
    .forge-step.done   { color: rgba(240,208,128,0.8); }
    .forge-step.active { color: rgba(201,168,76,1); }
    .step-dot { width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,0.1); flex-shrink: 0; transition: all 0.3s; }
    .forge-step.done   .step-dot { background: #C9A84C; box-shadow: 0 0 6px rgba(201,168,76,0.6); }
    .forge-step.active .step-dot { background: #F0D080; box-shadow: 0 0 10px rgba(240,208,128,0.8); animation: dot-pulse 0.8s ease-in-out infinite; }
    @keyframes dot-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.5); } }

    /* ══ PANTALLA 4 ══ */
    .screen4 { position: fixed; inset: 0; z-index: 150; background: rgba(8,4,4,0.97); display: none; align-items: center; justify-content: center; gap: 5vw; padding: 0 60px; opacity: 0; transition: opacity 0.5s ease; overflow-y: auto; }
    .screen4.open { display: flex; opacity: 1; }
    .s4-card-col { flex-shrink: 0; perspective: 1000px; animation: s4-card-enter 0.8s ease forwards; opacity: 0; }
    @keyframes s4-card-enter { from { opacity: 0; transform: translateY(30px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
    /* [resto de reglas visuales de la carta vieja migrado a la carta real v2.1] */
    .s4-customize-col { flex: 1; max-width: 380px; display: flex; flex-direction: column; animation: s4-text-enter 0.8s 0.3s ease forwards; opacity: 0; }
    @keyframes s4-text-enter { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }
    .s4-title { font-family: 'Cinzel Decorative', serif; font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 700; color: var(--gold); letter-spacing: 0.1em; margin-bottom: 0.4rem; text-shadow: 0 0 20px rgba(201,168,76,0.3); }
    .s4-subtitle { font-size: 0.6rem; letter-spacing: 0.3em; color: rgba(168,180,192,0.5); text-transform: uppercase; margin-bottom: 1.8rem; }
    .s4-input-wrap { margin-bottom: 1.2rem; }
    .s4-input-label { font-size: 0.52rem; letter-spacing: 0.3em; color: rgba(201,168,76,0.6); text-transform: uppercase; margin-bottom: 8px; display: block; }
    .s4-input { width: 100%; background: rgba(255,255,255,0.03); border: 1px solid rgba(201,168,76,0.25); border-radius: 6px; padding: 12px 16px; color: var(--gold-light); font-family: 'Cinzel', serif; font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase; outline: none; transition: all 0.3s; }
    .s4-input:focus { border-color: var(--gold); box-shadow: 0 0 15px rgba(201,168,76,0.2); }
    .s4-input::placeholder { color: rgba(168,180,192,0.2); font-size: 0.65rem; text-transform: none; }
    .s4-titles-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 1.2rem; }
    .s4-title-opt { padding: 8px 10px; background: rgba(255,255,255,0.02); border: 1px solid rgba(201,168,76,0.12); border-radius: 4px; cursor: pointer; font-family: 'Cinzel', serif; font-size: 0.5rem; letter-spacing: 0.15em; color: rgba(168,180,192,0.45); text-transform: uppercase; transition: all 0.2s; text-align: center; }
    .s4-title-opt:hover { border-color: rgba(201,168,76,0.4); color: var(--gold-light); background: rgba(201,168,76,0.06); }
    .s4-title-opt.selected { border-color: var(--gold); color: var(--gold-light); background: rgba(201,168,76,0.1); box-shadow: 0 0 10px rgba(201,168,76,0.2); }
    /* [selectores de Background/Color/Effect eliminados -- Season II] */
    .s4-btn { position: relative; background: none; border: none; cursor: pointer; padding: 0; font-family: 'Cinzel', serif; width: 100%; }
    .s4-btn-inner { display: flex; align-items: center; justify-content: center; gap: 12px; padding: 1rem 2rem; background: linear-gradient(135deg, #6b4f10 0%, #C9A84C 25%, #F0D080 50%, #C9A84C 75%, #6b4f10 100%); clip-path: polygon(16px 0%, calc(100% - 16px) 0%, 100% 50%, calc(100% - 16px) 100%, 16px 100%, 0% 50%); transition: all 0.3s ease; }
    .s4-btn:hover .s4-btn-inner { background: linear-gradient(135deg, #8B6914 0%, #F0D080 35%, #fffacc 50%, #F0D080 65%, #8B6914 100%); box-shadow: 0 0 40px rgba(201,168,76,0.5); transform: scale(1.02); }
    .s4-btn-text { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.4em; color: #0a0700; text-transform: uppercase; }

    /* ══ PANTALLA 5 — ARENA ══ */
    .screen5 { position: fixed; inset: 0; z-index: 150; background: rgba(8,4,4,0.97); display: none; overflow: hidden; opacity: 0; transition: opacity 0.5s ease; }
    .screen5.open { display: flex; opacity: 1; }
    .arena-sidebar { width: 260px; flex-shrink: 0; border-right: 1px solid rgba(201,168,76,0.15); display: flex; flex-direction: column; padding: 24px 16px; gap: 16px; background: rgba(0,0,0,0.3); overflow-y: auto; }
    .arena-sidebar-title { font-size: 0.5rem; letter-spacing: 0.4em; color: rgba(201,168,76,0.4); text-transform: uppercase; text-align: center; margin-bottom: 4px; }
    .arena-mini-card { background: linear-gradient(160deg, #1c0c08 0%, #0e0e12 60%, #080810 100%); border-radius: 10px; padding: 12px 10px; position: relative; box-shadow: 0 0 0 1px #6b4f10, 0 0 0 2px #0e0e12, 0 0 0 3px #C9A84C, 0 0 20px rgba(201,168,76,0.2), inset 0 0 30px rgba(0,0,0,0.5); animation: card-float 5s ease-in-out infinite; }
    .arena-mini-corner { position: absolute; width: 12px; height: 12px; border-color: #C9A84C; border-style: solid; opacity: 0.6; }
    .arena-mini-corner.tl { top: 5px; left: 5px; border-width: 1px 0 0 1px; }
    .arena-mini-corner.tr { top: 5px; right: 5px; border-width: 1px 1px 0 0; }
    .arena-mini-corner.bl { bottom: 5px; left: 5px; border-width: 0 0 1px 1px; }
    .arena-mini-corner.br { bottom: 5px; right: 5px; border-width: 0 1px 1px 0; }
    .mini-avatar { width: 44px; height: 44px; border-radius: 50%; margin: 0 auto 6px; background: radial-gradient(circle at 35% 35%, #2a1a0a, #0e0a04); border: 1.5px solid rgba(201,168,76,0.4); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; }
    .mini-name { text-align: center; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.2em; color: #F0D080; text-transform: uppercase; margin-bottom: 2px; }
    .mini-title-text { text-align: center; font-size: 0.42rem; letter-spacing: 0.15em; color: rgba(168,180,192,0.4); margin-bottom: 8px; font-style: italic; }
    .mini-hline { height: 1px; background: linear-gradient(to right, transparent, rgba(201,168,76,0.2), transparent); margin-bottom: 8px; }
    .mini-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; margin-bottom: 8px; }
    .mini-stat { background: rgba(255,255,255,0.02); border: 1px solid rgba(201,168,76,0.08); border-radius: 3px; padding: 4px 6px; }
    .mini-stat-label { font-size: 0.36rem; letter-spacing: 0.15em; color: rgba(168,180,192,0.35); text-transform: uppercase; }
    .mini-stat-val { font-size: 0.58rem; font-weight: 700; color: #F0D080; }
    .mini-power-bar { height: 3px; background: rgba(255,255,255,0.05); border-radius: 2px; margin-bottom: 6px; overflow: hidden; }
    .mini-power-fill { height: 100%; width: 72%; background: linear-gradient(to right, #8B6914, #C9A84C, #F0D080); }
    .mini-badges { display: flex; justify-content: center; gap: 5px; }
    .mini-badge { font-size: 0.7rem; opacity: 0.8; }
    .mini-badge.locked { opacity: 0.2; filter: grayscale(1); }
    .arena-nav { display: flex; flex-direction: column; gap: 6px; }
    .arena-nav-btn { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 6px; cursor: pointer; background: rgba(255,255,255,0.02); border: 1px solid rgba(201,168,76,0.1); transition: all 0.25s; font-family: 'Cinzel', serif; }
    .arena-nav-btn:hover { background: rgba(201,168,76,0.08); border-color: rgba(201,168,76,0.3); }
    .arena-nav-btn.active { background: rgba(201,168,76,0.1); border-color: var(--gold); box-shadow: 0 0 10px rgba(201,168,76,0.15); }
    .arena-nav-icon { font-size: 1rem; }
    .arena-nav-text { font-size: 0.55rem; font-weight: 700; letter-spacing: 0.2em; color: rgba(240,208,128,0.7); text-transform: uppercase; }
    .arena-nav-btn.active .arena-nav-text { color: #F0D080; }
    .arena-nav-badge { margin-left: auto; background: #CC2200; color: white; font-size: 0.4rem; padding: 2px 5px; border-radius: 10px; font-weight: 700; }
    .arena-main { flex: 1; display: flex; flex-direction: column; padding: 24px 28px; overflow-y: auto; gap: 20px; }
    .arena-header { display: flex; align-items: center; justify-content: space-between; }
    .arena-header-title { font-family: 'Cinzel Decorative', serif; font-size: 1.4rem; font-weight: 700; color: #C9A84C; text-shadow: 0 0 20px rgba(201,168,76,0.3); }
    .arena-header-sub { font-size: 0.52rem; letter-spacing: 0.3em; color: rgba(168,180,192,0.4); text-transform: uppercase; margin-top: 2px; }
    .arena-season-badge { font-size: 0.5rem; letter-spacing: 0.3em; color: var(--gold); border: 1px solid rgba(201,168,76,0.3); padding: 5px 12px; border-radius: 2px; text-transform: uppercase; font-family: 'Cinzel', serif; }
    .arena-panel { background: rgba(255,255,255,0.02); border: 1px solid rgba(201,168,76,0.1); border-radius: 10px; padding: 20px 22px; }
    .arena-panel-title { font-size: 0.6rem; font-weight: 700; letter-spacing: 0.3em; color: rgba(201,168,76,0.7); text-transform: uppercase; margin-bottom: 14px; display: flex; align-items: center; gap: 8px; }
    .arena-panel-title::after { content: ''; flex: 1; height: 1px; background: linear-gradient(to right, rgba(201,168,76,0.2), transparent); }
    .challenge-input-wrap { display: flex; gap: 10px; margin-bottom: 10px; }
    .challenge-input { flex: 1; background: rgba(255,255,255,0.03); border: 1px solid rgba(201,168,76,0.2); border-radius: 6px; padding: 10px 14px; color: #F0D080; font-family: 'Cinzel', serif; font-size: 0.65rem; letter-spacing: 0.1em; outline: none; transition: all 0.3s; }
    .challenge-input:focus { border-color: var(--gold); box-shadow: 0 0 12px rgba(201,168,76,0.15); }
    .challenge-input::placeholder { color: rgba(168,180,192,0.25); font-size: 0.58rem; }
    .challenge-btn { background: linear-gradient(135deg, #6b4f10, #C9A84C, #F0D080, #C9A84C, #6b4f10); border: none; border-radius: 6px; padding: 10px 20px; font-family: 'Cinzel', serif; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.25em; color: #0a0700; text-transform: uppercase; cursor: pointer; transition: all 0.3s; white-space: nowrap; }
    .challenge-btn:hover { box-shadow: 0 0 20px rgba(201,168,76,0.4); transform: scale(1.02); }
    .random-duel-btn { width: 100%; padding: 14px; background: rgba(139,26,26,0.15); border: 1px solid rgba(204,34,0,0.3); border-radius: 6px; font-family: 'Cinzel', serif; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.3em; color: #CC4422; text-transform: uppercase; cursor: pointer; transition: all 0.3s; display: flex; align-items: center; justify-content: center; gap: 10px; }
    .random-duel-btn:hover { background: rgba(139,26,26,0.3); border-color: #CC2200; box-shadow: 0 0 20px rgba(204,34,0,0.3); }
    .leaderboard-list { display: flex; flex-direction: column; gap: 6px; }
    .lb-row { display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-radius: 6px; background: rgba(255,255,255,0.02); border: 1px solid rgba(201,168,76,0.07); transition: all 0.2s; cursor: pointer; }
    .lb-row:hover { background: rgba(201,168,76,0.05); border-color: rgba(201,168,76,0.2); }
    .lb-row.you { border-color: rgba(201,168,76,0.3); background: rgba(201,168,76,0.06); }
    .lb-rank { font-size: 0.7rem; font-weight: 700; color: rgba(201,168,76,0.4); width: 24px; text-align: center; font-family: 'Cinzel', serif; }
    .lb-rank.top { color: #F0D080; }
    .lb-avatar { width: 30px; height: 30px; border-radius: 50%; background: radial-gradient(circle, #2a1a0a, #0e0a04); border: 1px solid rgba(201,168,76,0.3); display: flex; align-items: center; justify-content: center; font-size: 0.8rem; flex-shrink: 0; }
    .lb-info { flex: 1; }
    .lb-name { font-size: 0.58rem; font-weight: 700; letter-spacing: 0.15em; color: #F0D080; text-transform: uppercase; }
    .lb-title-lb { font-size: 0.42rem; letter-spacing: 0.1em; color: rgba(168,180,192,0.35); }
    .lb-power { font-size: 0.62rem; font-weight: 700; color: #C9A84C; font-family: 'Cinzel', serif; }
    .lb-wins { font-size: 0.42rem; letter-spacing: 0.1em; color: rgba(168,180,192,0.35); text-align: right; }
    .challenge-item { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 6px; background: rgba(139,26,26,0.08); border: 1px solid rgba(204,34,0,0.2); margin-bottom: 6px; }
    .challenge-item-avatar { font-size: 1.2rem; }
    .challenge-item-info { flex: 1; }
    .challenge-item-name { font-size: 0.58rem; font-weight: 700; letter-spacing: 0.15em; color: #F0D080; text-transform: uppercase; }
    .challenge-item-meta { font-size: 0.42rem; letter-spacing: 0.1em; color: rgba(168,180,192,0.35); }
    .challenge-accept-btn { background: linear-gradient(135deg, #6b4f10, #C9A84C); border: none; border-radius: 4px; padding: 6px 14px; font-family: 'Cinzel', serif; font-size: 0.48rem; font-weight: 700; letter-spacing: 0.2em; color: #0a0700; text-transform: uppercase; cursor: pointer; transition: all 0.2s; }
    .challenge-accept-btn:hover { box-shadow: 0 0 12px rgba(201,168,76,0.4); }

    .card-view-modal { position: fixed; inset: 0; z-index: 400; background: rgba(4,2,0,0.92); display: none; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.3s ease; backdrop-filter: blur(6px); }
    .card-view-modal.open { display: flex; opacity: 1; }

    .bp-panel { width: min(480px, 90vw); max-height: 86vh; overflow-y: auto; background: linear-gradient(160deg, #1c0c08 0%, #0e0e12 60%, #080810 100%); border-radius: 10px; padding: 32px 28px; box-shadow: 0 0 0 1px #6b4f10, 0 0 0 2px #0e0e12, 0 0 0 3px #C9A84C, 0 0 40px rgba(201,168,76,0.25); position: relative; }
    .bp-title { font-family: 'Cinzel Decorative', serif; font-size: 1.1rem; color: var(--gold-light); text-align: center; letter-spacing: 0.08em; margin-bottom: 4px; }
    .bp-sub { text-align: center; font-size: 0.6rem; letter-spacing: 0.15em; color: rgba(168,180,192,0.5); text-transform: uppercase; margin-bottom: 24px; }
    .bp-order-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 26px; }
    .bp-order-row { display: flex; align-items: center; gap: 12px; padding: 10px 14px; background: rgba(255,255,255,0.03); border: 1px solid rgba(201,168,76,0.15); border-radius: 6px; }
    .bp-order-num { width: 20px; height: 20px; border-radius: 50%; background: rgba(201,168,76,0.15); border: 1px solid rgba(201,168,76,0.4); display: flex; align-items: center; justify-content: center; font-size: 0.6rem; color: #F0D080; flex-shrink: 0; }
    .bp-order-label { flex: 1; font-size: 0.7rem; letter-spacing: 0.1em; color: rgba(224,224,224,0.9); text-transform: uppercase; }
    .bp-order-arrows { display: flex; gap: 4px; }
    .bp-arrow-btn { width: 24px; height: 24px; border-radius: 4px; background: rgba(255,255,255,0.04); border: 1px solid rgba(201,168,76,0.2); color: rgba(201,168,76,0.8); cursor: pointer; font-size: 0.6rem; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
    .bp-arrow-btn:hover:not(:disabled) { background: rgba(201,168,76,0.15); border-color: var(--gold); }
    .bp-arrow-btn:disabled { opacity: 0.25; cursor: default; }
    .bp-wildcard-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 26px; }
    .bp-wc-opt { padding: 12px 10px; border-radius: 6px; border: 1px solid rgba(201,168,76,0.15); background: rgba(255,255,255,0.02); cursor: pointer; text-align: center; transition: all 0.2s; }
    .bp-wc-opt:hover:not(.locked) { border-color: rgba(201,168,76,0.5); background: rgba(201,168,76,0.06); }
    .bp-wc-opt.selected { border-color: var(--gold); background: rgba(201,168,76,0.12); box-shadow: 0 0 12px rgba(201,168,76,0.2); }
    .bp-wc-opt.locked { opacity: 0.4; cursor: not-allowed; }
    .bp-wc-icon { font-size: 1.3rem; margin-bottom: 4px; }
    .bp-wc-name { font-size: 0.6rem; letter-spacing: 0.08em; color: #F0D080; text-transform: uppercase; margin-bottom: 2px; }
    .bp-wc-req { font-size: 0.48rem; letter-spacing: 0.05em; color: rgba(168,180,192,0.5); }
    .bp-save-btn { width: 100%; background: linear-gradient(135deg,#6b4f10,#C9A84C,#F0D080,#C9A84C,#6b4f10); border: none; border-radius: 6px; padding: 13px; font-family: 'Cinzel',serif; font-size: 0.65rem; font-weight: 700; letter-spacing: 0.3em; color: #0a0700; text-transform: uppercase; cursor: pointer; transition: all 0.3s; }
    .bp-save-btn:hover { box-shadow: 0 0 25px rgba(201,168,76,0.4); }
    .bp-close { position: absolute; top: 14px; right: 14px; background: none; border: 1px solid rgba(201,168,76,0.3); color: var(--gold-light); width: 30px; height: 30px; border-radius: 50%; cursor: pointer; font-family:'Cinzel',serif; }
    .bp-status { text-align: center; font-size: 0.58rem; letter-spacing: 0.1em; color: #4ade80; margin-top: 12px; min-height: 14px; }

    .soon-badge { position: absolute; top: -6px; right: -6px; background: linear-gradient(135deg,#8B1A1A,#CC2200); color: #fff; font-size: 0.42rem; font-weight: 700; letter-spacing: 0.05em; padding: 2px 5px; border-radius: 4px; box-shadow: 0 0 8px rgba(204,34,0,0.5); }
    .soon-panel { width: min(420px, 90vw); text-align: center; background: linear-gradient(160deg, #1c0c08 0%, #0e0e12 60%, #080810 100%); border-radius: 10px; padding: 40px 32px; box-shadow: 0 0 0 1px #6b4f10, 0 0 0 2px #0e0e12, 0 0 0 3px #C9A84C, 0 0 40px rgba(201,168,76,0.25); position: relative; }
    .soon-icon { font-size: 3rem; margin-bottom: 14px; filter: drop-shadow(0 0 20px rgba(201,168,76,0.5)); }
    .soon-title { font-family: 'Cinzel Decorative', serif; font-size: 1.2rem; color: var(--gold-light); letter-spacing: 0.06em; margin-bottom: 10px; }
    .soon-desc { font-size: 0.68rem; line-height: 1.7; color: rgba(168,180,192,0.7); margin-bottom: 20px; }
    .soon-tag { display: inline-block; font-size: 0.55rem; letter-spacing: 0.3em; color: #ff9d8a; text-transform: uppercase; border: 1px solid rgba(204,34,0,0.4); border-radius: 20px; padding: 6px 18px; }
    .card-view-close { position: absolute; top: 28px; right: 32px; background: none; border: 1px solid rgba(201,168,76,0.4); color: var(--gold-light); font-size: 1.1rem; width: 40px; height: 40px; border-radius: 50%; cursor: pointer; transition: all 0.2s; font-family: 'Cinzel', serif; }
    .card-view-close:hover { border-color: var(--gold); background: rgba(201,168,76,0.1); }

    /* ══ PANTALLA 6 — COMBAT (rediseño épico) ══ */
    .screen6 { position: fixed; inset: 0; z-index: 300; background: #050302; display: none; flex-direction: column; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.5s ease; overflow: hidden; }
    .screen6.open { display: flex; opacity: 1; }
    .screen6.shake { animation: screen-shake 0.45s ease; }
    @keyframes screen-shake { 0%,100%{transform:translate(0,0);} 10%{transform:translate(-9px,4px);} 22%{transform:translate(8px,-6px);} 34%{transform:translate(-7px,5px);} 46%{transform:translate(6px,-4px);} 58%{transform:translate(-4px,3px);} 70%{transform:translate(3px,-2px);} 82%{transform:translate(-2px,1px);} 92%{transform:translate(1px,-1px);} }

    .combat-bg { position: absolute; inset: 0; background: radial-gradient(ellipse 90% 70% at 50% 15%, #241009 0%, #050302 55%); z-index: 0; }
    .combat-bg-image { position: absolute; inset: 0; background: url('bg-combat-axes.jpg') center 30%/45% no-repeat; opacity: 0.4; z-index: 0; mix-blend-mode: screen; }
    .combat-spotlight { position: absolute; top: -10%; left: 50%; transform: translateX(-50%); width: 60%; height: 75%; background: radial-gradient(ellipse 50% 100% at 50% 0%, rgba(240,208,128,0.14) 0%, transparent 70%); z-index: 1; pointer-events: none; }
    .combat-floor-glow { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 70%; height: 180px; background: radial-gradient(ellipse 50% 100% at 50% 100%, rgba(204,34,0,0.16) 0%, transparent 75%); z-index: 1; pointer-events: none; }
    .combat-embers { position: absolute; inset: 0; z-index: 2; pointer-events: none; overflow: hidden; }
    .combat-bg-glow { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 400px; height: 400px; background: radial-gradient(circle, rgba(204,34,0,0.10) 0%, transparent 70%); z-index: 1; animation: glowPulse 2s ease-in-out infinite; pointer-events:none; }
    @keyframes glowPulse { 0%,100%{transform:translate(-50%,-50%) scale(0.9);opacity:0.7;} 50%{transform:translate(-50%,-50%) scale(1.15);opacity:1;} }

    .score-box { position: relative; }
    .score-box .sb-corner { position: absolute; width: 9px; height: 9px; border-color: currentColor; border-style: solid; opacity: 0.7; }
    .score-box .sb-corner.tl { top: -1px; left: -1px; border-width: 1.2px 0 0 1.2px; }
    .score-box .sb-corner.tr { top: -1px; right: -1px; border-width: 1.2px 1.2px 0 0; }
    .score-box .sb-corner.bl { bottom: -1px; left: -1px; border-width: 0 0 1.2px 1.2px; }
    .score-box .sb-corner.br { bottom: -1px; right: -1px; border-width: 0 1.2px 1.2px 0; }
    .score-box .sb-gem { position: absolute; top: -5px; left: 50%; transform: translateX(-50%) rotate(45deg); width: 5px; height: 5px; background: currentColor; opacity: 0.8; }

    /* ── MEDALLON DE LUCHADOR (mismo lenguaje visual que la Combat Card) ── */
    .duel-medallion { width: 132px; height: 132px; border-radius: 50%; position: relative; flex-shrink:0; }
    .duel-medallion .med-ring { position: absolute; inset: -6px; border-radius: 50%; background: conic-gradient(from 0deg, #8B6914, #F0D080, #C9A84C, #F0D080, #8B6914); -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 6px), #000 calc(100% - 6px)); mask: radial-gradient(farthest-side, transparent calc(100% - 6px), #000 calc(100% - 6px)); box-shadow: 0 0 34px rgba(201,168,76,0.55); }
    .duel-medallion.opp .med-ring { background: conic-gradient(from 0deg, #4a0d08, #CC2200, #8B1A1A, #CC2200, #4a0d08); box-shadow: 0 0 34px rgba(204,34,0,0.45); }
    .duel-medallion .med-face { position: absolute; inset: 7px; border-radius: 50%; overflow: hidden; background: radial-gradient(circle, #1c0c08, #080604); display: flex; align-items: center; justify-content: center; }
    .duel-medallion .med-face img { width: 100%; height: 100%; object-fit: cover; display:block; }
    .duel-medallion .med-seal { font-family: 'Cinzel Decorative', serif; font-weight: 900; font-size: 2.9rem; color: var(--gold-light); text-shadow: 0 0 20px rgba(201,168,76,0.6); }
    .duel-medallion.opp .med-seal { color: #ff9d8a; text-shadow: 0 0 20px rgba(204,34,0,0.55); }
    .duel-medallion.winner { animation: medallion-victory 1s ease forwards; }
    @keyframes medallion-victory { 0%{transform:scale(1);} 45%{transform:scale(1.22);} 100%{transform:scale(1.1);} }
    .duel-medallion.loser { filter: grayscale(1) brightness(0.42); transform: scale(0.9); transition: filter 1s ease, transform 1s ease; }
    .med-aura { position: absolute; inset: -34px; border-radius: 50%; background: radial-gradient(circle, rgba(240,208,128,0.55), transparent 70%); opacity: 0; pointer-events: none; }
    .med-aura.burst { animation: aura-burst 1.4s ease forwards; }
    @keyframes aura-burst { 0%{opacity:0; transform:scale(0.6);} 30%{opacity:1; transform:scale(1.15);} 100%{opacity:0; transform:scale(1.6);} }

    /* ── RAYO entre medallones (choque de cada ronda) ── */
    .lightning-layer { position: absolute; inset: 0; z-index: 25; pointer-events: none; opacity: 0; }
    .lightning-layer.strike { animation: lightning-flash 0.4s ease; }
    @keyframes lightning-flash { 0%{opacity:0;} 12%{opacity:1;} 28%{opacity:0.15;} 42%{opacity:1;} 100%{opacity:0;} }
    .lightning-layer svg { width: 100%; height: 100%; }

    /* ── partículas de choque (chispas) ── */
    .clash-spark { position: absolute; width: 4px; height: 4px; border-radius: 50%; pointer-events: none; z-index: 26; animation: clash-spark-fly 0.6s ease-out forwards; }
    @keyframes clash-spark-fly { 0%{transform: translate(0,0) scale(1); opacity:1;} 100%{transform: translate(var(--sx), var(--sy)) scale(0.2); opacity:0;} }

    /* INTRO STATE */
    .combat-intro { position: absolute; inset: 0; z-index: 10; display: flex; align-items: center; justify-content: center; gap: 60px; transition: opacity 0.6s ease; }
    .intro-card-wrap { display: flex; flex-direction: column; align-items: center; gap: 16px; }
    .intro-card-wrap.left { animation: slideInLeft 0.7s 0.2s ease both; }
    .intro-card-wrap.right { animation: slideInRight 0.7s 0.2s ease both; }
    @keyframes slideInLeft  { from{transform:translateX(-160px);opacity:0;} to{transform:translateX(0);opacity:1;} }
    @keyframes slideInRight { from{transform:translateX(160px);opacity:0;} to{transform:translateX(0);opacity:1;} }
    .intro-card-name { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.3em; color: var(--gold-light); text-transform: uppercase; text-shadow: 0 0 10px rgba(201,168,76,0.5); }
    .intro-card-rank { font-size: 0.45rem; letter-spacing: 0.2em; color: rgba(168,180,192,0.5); text-transform: uppercase; }
    .intro-vs { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); z-index: 15; width: 76px; height: 76px; border-radius: 50%; background: radial-gradient(circle, #3a0a08, #1a0404); border: 2px solid #CC2200; display: flex; align-items: center; justify-content: center; font-family: 'Cinzel Decorative',serif; font-size: 1.3rem; font-weight: 900; color: #CC2200; box-shadow: 0 0 30px rgba(204,34,0,0.6), inset 0 0 20px rgba(0,0,0,0.5); animation: vsPulse 1.5s ease-in-out infinite; }
    @keyframes vsPulse { 0%,100%{box-shadow:0 0 30px rgba(204,34,0,0.6),inset 0 0 20px rgba(0,0,0,0.5);} 50%{box-shadow:0 0 60px rgba(204,34,0,0.9),inset 0 0 20px rgba(0,0,0,0.5);} }
    .intro-btn { margin-top: 40px; position: relative; z-index: 15; background: linear-gradient(135deg,#6b4f10,#C9A84C,#F0D080,#C9A84C,#6b4f10); border: none; border-radius: 6px; padding: 14px 40px; font-family: 'Cinzel',serif; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.4em; color: #0a0700; text-transform: uppercase; cursor: pointer; animation: btnAppear 0.5s 1.2s ease both; transition: all 0.3s; }
    @keyframes btnAppear { from{opacity:0;transform:translateY(20px);} to{opacity:1;transform:translateY(0);} }
    .intro-btn:hover { box-shadow: 0 0 30px rgba(201,168,76,0.5); transform: scale(1.04); }

    /* ROUND FIGHT UI */
    .combat-ui { position: absolute; inset: 0; z-index: 10; display: none; flex-direction: column; }
    .combat-top { display: flex; align-items: center; justify-content: space-between; padding: 20px 40px 0; }
    .fighter-header { display: flex; flex-direction: column; gap: 4px; }
    .fighter-header.right { align-items: flex-end; }
    .fighter-hname { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.25em; text-transform: uppercase; }
    .fighter-hname.me  { color: #F0D080; text-shadow: 0 0 10px rgba(201,168,76,0.5); }
    .fighter-hname.opp { color: #ff9d8a; text-shadow: 0 0 10px rgba(204,34,0,0.4); }
    .fighter-htitle { font-size: 0.45rem; letter-spacing: 0.2em; color: rgba(168,180,192,0.4); text-transform: uppercase; }
    .combat-score-center { display: flex; align-items: center; gap: 16px; }
    .score-box { width: 52px; height: 52px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-family: 'Cinzel Decorative',serif; font-size: 1.8rem; font-weight: 900; transition: all 0.4s; }
    .score-box.me  { background: rgba(201,168,76,0.1); border: 1px solid rgba(201,168,76,0.3); color: #F0D080; }
    .score-box.opp { background: rgba(204,34,0,0.1); border: 1px solid rgba(204,34,0,0.3); color: #ff9d8a; }
    .score-box.win { transform: scale(1.2); box-shadow: 0 0 20px currentColor; }
    .score-divider { font-size: 1.2rem; color: rgba(168,180,192,0.3); font-family: 'Cinzel',serif; }

    .combat-arena { flex: 1; display: flex; align-items: center; justify-content: center; gap: 0; position: relative; padding: 10px 0; }
    .fighter-col { display: flex; flex-direction: column; align-items: center; width: 260px; gap: 12px; }

    .round-label { font-size: 0.5rem; letter-spacing: 0.4em; color: rgba(201,168,76,0.6); text-transform: uppercase; text-align: center; margin-bottom: 4px; }
    .round-title-big { font-family: 'Cinzel Decorative',serif; font-size: 1.1rem; font-weight: 700; color: #CC2200; text-align: center; text-transform: uppercase; letter-spacing: 0.1em; text-shadow: 0 0 20px rgba(204,34,0,0.6); margin-bottom: 16px; }

    .bars-wrap { width: 100%; display: flex; flex-direction: column; gap: 14px; padding: 0 20px; }
    .bar-row { display: flex; flex-direction: column; gap: 6px; }
    .bar-meta { display: flex; justify-content: space-between; font-size: 0.52rem; letter-spacing: 0.15em; color: rgba(168,180,192,0.5); text-transform: uppercase; }
    .bar-track { height: 10px; background: rgba(255,255,255,0.04); border-radius: 6px; border: 1px solid rgba(255,255,255,0.06); overflow: hidden; position: relative; }
    .bar-fill { height: 100%; width: 0%; border-radius: 6px; transition: width 1.4s cubic-bezier(0.25,0.46,0.45,0.94); position: relative; }
    .bar-fill.me  { background: linear-gradient(to right,#8B6914,#C9A84C,#F0D080); box-shadow: 0 0 8px rgba(201,168,76,0.6); }
    .bar-fill.opp { background: linear-gradient(to right,#4a0d08,#CC2200,#ff9d8a); box-shadow: 0 0 8px rgba(204,34,0,0.6); }
    .bar-fill.winner { animation: barWin 0.4s 1.5s ease forwards; }
    @keyframes barWin { 0%{filter:brightness(1);} 50%{filter:brightness(1.8);} 100%{filter:brightness(1.3);} }

    .round-result-badge { text-align: center; margin-top: 8px; font-size: 0.55rem; letter-spacing: 0.3em; text-transform: uppercase; padding: 6px 20px; border-radius: 4px; border: 1px solid; display: none; animation: badgeIn 0.4s ease; }
    @keyframes badgeIn { from{opacity:0;transform:scale(0.8);} to{opacity:1;transform:scale(1);} }
    .round-result-badge.me-win  { color: #F0D080; border-color: rgba(201,168,76,0.5); background: rgba(201,168,76,0.08); display: block; }
    .round-result-badge.opp-win { color: #ff9d8a; border-color: rgba(204,34,0,0.4); background: rgba(204,34,0,0.08); display: block; }

    .combat-dots { display: flex; gap: 10px; justify-content: center; margin-top: 8px; }
    .cdot { font-size: 0.85rem; color: rgba(255,255,255,0.18); transition: all 0.4s; filter: grayscale(1); }
    .cdot.active { color: rgba(201,168,76,0.8); filter: none; animation: dotPulse 1s ease-in-out infinite; }
    @keyframes dotPulse { 0%,100%{transform:scale(1);} 50%{transform:scale(1.25);} }
    .cdot.me-dot  { color: #C9A84C; filter: none; text-shadow: 0 0 8px rgba(201,168,76,0.7); }
    .cdot.opp-dot { color: #CC2200; filter: none; text-shadow: 0 0 8px rgba(204,34,0,0.7); }

    .combat-next-btn { position: absolute; bottom: 28px; left: 50%; transform: translateX(-50%); background: none; border: 1px solid rgba(201,168,76,0.3); border-radius: 4px; padding: 10px 30px; font-family: 'Cinzel',serif; font-size: 0.58rem; font-weight: 700; letter-spacing: 0.3em; color: rgba(201,168,76,0.7); text-transform: uppercase; cursor: pointer; transition: all 0.3s; display: none; }
    .combat-next-btn:hover { border-color: var(--gold); color: #F0D080; box-shadow: 0 0 15px rgba(201,168,76,0.2); }

    /* FLASH EFFECT */
    .impact-flash { position: absolute; inset: 0; background: rgba(255,200,50,0.18); pointer-events: none; opacity: 0; z-index: 50; border-radius: 0; }
    .impact-flash.opp-flash { background: rgba(255,60,20,0.22); }
    @keyframes flashIn { 0%{opacity:1;} 100%{opacity:0;} }

    /* RESULT SCREEN */
    .combat-result { position: absolute; inset: 0; z-index: 20; display: none; flex-direction: column; align-items: center; justify-content: center; background: radial-gradient(ellipse 65% 55% at 50% 50%, rgba(6,3,2,0.72) 0%, rgba(6,3,2,0.95) 100%); backdrop-filter: blur(1.5px); }
    .result-fx-layer { position: absolute; inset: 0; pointer-events: none; overflow: hidden; z-index: 0; }
    .result-icon-wrap { position: relative; width: 120px; height: 120px; display: flex; align-items: center; justify-content: center; margin-bottom: 6px; animation: crownDrop 0.7s 0.3s ease both; }
    @keyframes crownDrop { from{transform:translateY(-60px);opacity:0;} to{transform:translateY(0);opacity:1;} }
    .result-icon-wrap .icon-rays { position: absolute; inset: -40px; background: conic-gradient(from 0deg, transparent 0deg, rgba(240,208,128,0.35) 8deg, transparent 16deg, transparent 40deg, rgba(240,208,128,0.35) 48deg, transparent 56deg, transparent 90deg, rgba(240,208,128,0.35) 98deg, transparent 106deg, transparent 140deg, rgba(240,208,128,0.35) 148deg, transparent 156deg, transparent 190deg, rgba(240,208,128,0.35) 198deg, transparent 206deg, transparent 230deg, rgba(240,208,128,0.35) 238deg, transparent 246deg, transparent 280deg, rgba(240,208,128,0.35) 288deg, transparent 296deg, transparent 320deg, rgba(240,208,128,0.35) 328deg, transparent 336deg); animation: rays-spin 8s linear infinite; border-radius: 50%; }
    @keyframes rays-spin { from{transform:rotate(0deg);} to{transform:rotate(360deg);} }
    .result-icon-wrap svg { position: relative; z-index: 1; filter: drop-shadow(0 0 18px rgba(240,208,128,0.7)); }
    .result-icon-wrap.lose svg { filter: drop-shadow(0 0 14px rgba(150,20,10,0.6)); }

    .flame-particle { position: absolute; bottom: -10px; border-radius: 50%; pointer-events: none; animation: flame-rise linear forwards; }
    @keyframes flame-rise { 0%{transform:translateY(0) scale(1); opacity:0.9;} 100%{transform:translateY(-260px) scale(0.15); opacity:0;} }
    .blood-drip { position: absolute; top: -14px; width: 3px; border-radius: 0 0 3px 3px; background: linear-gradient(to bottom, #7a0f0a, #3a0805); pointer-events: none; animation: drip-fall linear forwards; }
    @keyframes drip-fall { 0%{transform:translateY(0); opacity:0;} 8%{opacity:0.9;} 100%{transform:translateY(340px); opacity:0.75;} }
    .result-winner-name { font-family:'Cinzel Decorative',serif; font-size: 2.5rem; font-weight:900; margin: 8px 0 4px; animation: nameSlide 0.6s 0.6s ease both; opacity:0; }
    @keyframes nameSlide { from{transform:scale(0.7);opacity:0;} to{transform:scale(1);opacity:1;} }
    .result-winner-name.me  { color:#F0D080; text-shadow:0 0 40px rgba(201,168,76,0.8); }
    .result-winner-name.opp { color:#ff9d8a; text-shadow:0 0 40px rgba(204,34,0,0.7); }
    .result-label { font-size:0.65rem; letter-spacing:0.4em; color:rgba(168,180,192,0.5); text-transform:uppercase; margin-bottom:24px; animation: nameSlide 0.6s 0.8s ease both; opacity:0; }
    .result-score { display:flex; align-items:center; gap:20px; margin-bottom:32px; animation: nameSlide 0.6s 1s ease both; opacity:0; }
    .result-score-num { font-family:'Cinzel Decorative',serif; font-size:3.5rem; font-weight:900; }
    .result-score-num.me  { color:#F0D080; text-shadow:0 0 30px rgba(201,168,76,0.6); }
    .result-score-num.opp { color:#ff9d8a; text-shadow:0 0 30px rgba(204,34,0,0.5); }
    .result-score-dash { font-size:2rem; color:rgba(168,180,192,0.3); font-family:'Cinzel',serif; }
    /* [insignias inventadas y confeti fantasma eliminados -- se sustituyen por fuego/sangre] */
    .result-btns { display:flex; gap:12px; animation: nameSlide 0.6s 1.4s ease both; opacity:0; }
    .result-share-btn { padding:12px 28px; border-radius:6px; font-family:'Cinzel',serif; font-size:0.6rem; font-weight:700; letter-spacing:0.25em; text-transform:uppercase; cursor:pointer; transition:all 0.3s; }
    .result-share-btn.x   { background:linear-gradient(135deg,#1a1a1a,#333); border:1px solid rgba(255,255,255,0.2); color:#fff; }
    .result-share-btn.x:hover { box-shadow:0 0 15px rgba(255,255,255,0.2); transform:scale(1.03); }
    .result-share-btn.fc  { background:linear-gradient(135deg,#3a2a10,#8B6914); border:1px solid rgba(201,168,76,0.4); color:#F0D080; }
    .result-share-btn.fc:hover { box-shadow:0 0 15px rgba(201,168,76,0.4); transform:scale(1.03); }
    .result-share-btn.again { background:linear-gradient(135deg,#6b4f10,#C9A84C,#F0D080,#C9A84C,#6b4f10); border:none; color:#0a0700; }
    .result-share-btn.again:hover { box-shadow:0 0 20px rgba(201,168,76,0.5); transform:scale(1.03); }
    /* result-confetti / .conf eliminados -- ver flame-particle / blood-drip arriba */

    /* ── CARTAS EN COMBATE (carta real + carta sombra del rival) ── */
    .fighter-col.card-col { width: 340px; }
    .card-fx-wrap { position: relative; }
    .card-fx-wrap.glow-pulse { animation: card-glow-pulse 0.8s ease; }
    @keyframes card-glow-pulse { 0%{filter:brightness(1) drop-shadow(0 0 0 rgba(240,208,128,0));} 40%{filter:brightness(1.25) drop-shadow(0 0 40px rgba(240,208,128,0.85));} 100%{filter:brightness(1) drop-shadow(0 0 12px rgba(240,208,128,0.25));} }
    .card-fx-wrap.victory-aura { filter: drop-shadow(0 0 50px rgba(240,208,128,0.6)); }

    .card-crack-overlay { position: absolute; inset: 0; pointer-events: none; z-index: 6; }
    .card-crack-overlay svg { width: 100%; height: 100%; }
    .card-crack-overlay .crack-line { opacity: 0; transition: opacity 0.3s ease; }
    .card-crack-overlay.stage-1 .crack-1 { opacity: 0.85; }
    .card-crack-overlay.stage-2 .crack-1, .card-crack-overlay.stage-2 .crack-2 { opacity: 0.9; }
    .card-crack-overlay.stage-3 .crack-1, .card-crack-overlay.stage-3 .crack-2, .card-crack-overlay.stage-3 .crack-3 { opacity: 1; }

    .card-stat.hit-highlight, .sc-stat-row.hit-highlight { animation: stat-highlight 1.6s ease; }
    @keyframes stat-highlight { 0%{box-shadow:0 0 0 rgba(201,168,76,0);} 25%{box-shadow:0 0 0 2px rgba(201,168,76,0.9), 0 0 20px rgba(201,168,76,0.6);} 100%{box-shadow:0 0 0 rgba(201,168,76,0);} }

    /* carta sombra del rival: mismo bulto que la real (320x560), gris/desaturada */
    .shadow-card { width: 320px; height: 560px; border-radius: 12px; position: relative; background: linear-gradient(160deg, #1e1e1e 0%, #0a0a0a 70%); border: 3px solid #3a3a3a; box-shadow: 0 0 30px rgba(0,0,0,0.6); overflow: hidden; filter: grayscale(1) brightness(0.85); transition: filter 0.8s ease; }
    .shadow-card .sc-medallion { width: 128px; height: 128px; border-radius: 50%; margin: 34px auto 14px; background: radial-gradient(circle, #2a2a2a, #0a0a0a); display: flex; align-items: center; justify-content: center; border: 4px solid #555; box-shadow: inset 0 0 20px rgba(0,0,0,0.6); }
    .sc-seal { font-family: 'Cinzel Decorative', serif; font-weight: 900; font-size: 2.6rem; color: #aaa; }
    .sc-name { text-align: center; font-family: 'Cinzel Decorative', serif; font-size: 1rem; letter-spacing: 0.12em; color: #ccc; margin-bottom: 4px; text-transform: uppercase; }
    .sc-sub { text-align: center; font-size: 0.55rem; letter-spacing: 0.2em; color: #777; text-transform: uppercase; margin-bottom: 20px; }
    .sc-stats { display: flex; flex-direction: column; gap: 11px; padding: 0 26px; }
    .sc-stat-row { display: flex; justify-content: space-between; align-items: center; font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: #666; border-bottom: 1px solid #2e2e2e; padding-bottom: 7px; transition: color 0.4s ease; }
    .sc-stat-row .sc-val { font-family: 'Cinzel Decorative', serif; font-size: 0.85rem; }
    .sc-stat-row.revealed { color: #ccc; }
    .sc-stat-row.revealed .sc-val { color: #ff9d8a; }

    /* banners dramaticos */
    .drama-banner { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%) scale(0.7); z-index: 60; text-align: center; opacity: 0; pointer-events: none; }
    .drama-banner.show { animation: drama-in-out 1.8s ease; }
    @keyframes drama-in-out { 0%{opacity:0; transform:translate(-50%,-50%) scale(0.6);} 15%{opacity:1; transform:translate(-50%,-50%) scale(1.08);} 25%{transform:translate(-50%,-50%) scale(1);} 80%{opacity:1;} 100%{opacity:0; transform:translate(-50%,-50%) scale(1.1);} }
    .drama-title { font-family: 'Cinzel Decorative', serif; font-weight: 900; font-size: 2.2rem; letter-spacing: 0.12em; color: #F0D080; text-shadow: 0 0 40px rgba(201,168,76,0.9), 0 0 80px rgba(201,168,76,0.5); text-transform: uppercase; white-space: nowrap; }
    .drama-title.danger { color: #ff6b4a; text-shadow: 0 0 40px rgba(204,34,0,0.9), 0 0 80px rgba(204,34,0,0.5); }
    .drama-sub { font-size: 0.6rem; letter-spacing: 0.4em; color: rgba(240,208,128,0.7); text-transform: uppercase; margin-top: 8px; }

    /* ticker de la pelea */
    .battle-ticker { position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%); width: 100%; max-width: 640px; max-height: 70px; overflow: hidden; display: flex; flex-direction: column-reverse; gap: 3px; padding: 0 20px; pointer-events: none; }
    .ticker-line { font-size: 0.52rem; letter-spacing: 0.05em; color: rgba(168,180,192,0.55); text-align: center; animation: ticker-in 0.4s ease; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    @keyframes ticker-in { from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);} }
    .ticker-line b { color: rgba(201,168,76,0.85); }
  </style><script src="https://cdnjs.cloudflare.com/ajax/libs/ethers/6.13.4/ethers.umd.min.js"></script>
<style>
:root {
  --black:#080808; --gold:#C9A84C; --gold-l:#F0D080; --gold-d:#8B6914;
  --red:#CC2200; --red-d:#8B1A1A; --silver:#A8B4C0; --purple:#8b5cf6; --purple-l:#c4b5fd;
}
#cardMount .ww-card {
  width:320px; height:560px; position:relative; border-radius:16px; overflow:hidden;
  cursor:pointer; transition:transform 0.4s cubic-bezier(0.23,1,0.32,1); transform-style:preserve-3d;
}
#cardMount .ww-card:hover { transform:translateY(-10px) scale(1.03); }
#cardMount .card-overlay { position:absolute; inset:0; border-radius:16px; pointer-events:none; }
#cardMount .card-frame { position:absolute; inset:0; border-radius:16px; pointer-events:none; }
#cardMount .card-content { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; border-radius:16px; overflow:hidden; }
#cardMount .card-top { width:100%; display:flex; align-items:center; justify-content:space-between; padding:12px 14px 8px; background:linear-gradient(to bottom, rgba(0,0,0,0.85), transparent); }
#cardMount .card-rank-badge { font-family:'Cinzel', serif; font-size:0.5rem; font-weight:700; letter-spacing:0.3em; text-transform:uppercase; padding:4px 10px; border-radius:3px; border:1px solid; }
#cardMount .card-season { font-size:0.6rem; letter-spacing:0.25em; color:var(--gold); text-transform:uppercase; font-weight:600; }
#cardMount .card-art-zone { flex:1; width:100%; position:relative; display:flex; align-items:center; justify-content:flex-start; padding-top:30px; }
#cardMount .card-medallion { width:100px; height:100px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:3rem; position:relative; z-index:2; border:3px solid; transition:all 0.5s; }
#cardMount .card-medallion::before { content:''; position:absolute; inset:-8px; border-radius:50%; border:1px solid; opacity:0.3; animation:medalRing 3s ease-in-out infinite; }
#cardMount .card-medallion::after { content:''; position:absolute; inset:-16px; border-radius:50%; border:1px solid; opacity:0.15; animation:medalRing 3s ease-in-out infinite reverse; }
@keyframes medalRing { 0%,100%{transform:scale(1);opacity:0.3;} 50%{transform:scale(1.08);opacity:0.6;} }
#cardMount .card-bottom { width:100%; background:linear-gradient(to top, rgba(0,0,0,0.97) 62%, transparent); padding:22px 14px 12px; display:flex; flex-direction:column; gap:7px; }
#cardMount .card-name-row { display:flex; flex-direction:column; align-items:center; gap:3px; }
#cardMount .card-name { font-family:'Cinzel Decorative', serif; font-size:1rem; font-weight:700; letter-spacing:0.15em; text-align:center; text-transform:uppercase; line-height:1.1; }
#cardMount .card-title { font-family:'IM Fell English', serif; font-size:0.65rem; font-style:italic; letter-spacing:0.1em; color:rgba(168,180,192,0.6); text-align:center; }
#cardMount .card-power-row { display:flex; align-items:center; gap:8px; }
#cardMount .card-power-label { font-size:0.38rem; letter-spacing:0.3em; text-transform:uppercase; white-space:nowrap; opacity:0.5; min-width:52px; }
#cardMount .card-power-track { flex:1; height:10px; background:rgba(255,255,255,0.08); border-radius:5px; overflow:hidden; border:1px solid rgba(201,168,76,0.35); box-shadow:0 0 8px rgba(201,168,76,0.25), inset 0 1px 2px rgba(0,0,0,0.5); }
#cardMount .card-power-fill { height:100%; border-radius:3px; transition:width 1.5s cubic-bezier(0.25,0.46,0.45,0.94); position:relative; }
#cardMount .card-power-fill::after { content:''; position:absolute; right:0; top:0; bottom:0; width:6px; background:rgba(255,255,255,0.6); border-radius:3px; filter:blur(2px); }
#cardMount .card-power-val { font-size:0.52rem; font-weight:700; letter-spacing:0.1em; min-width:38px; text-align:right; }
#cardMount .card-divider { height:1px; background:linear-gradient(to right, transparent, currentColor, transparent); opacity:0.15; margin:2px 4px; }
#cardMount .card-stats { display:flex; justify-content:space-between; gap:3px; }
#cardMount .card-stat { display:flex; flex-direction:column; align-items:center; gap:2px; flex:1; }
#cardMount .card-stat-val { font-size:0.62rem; font-weight:700; letter-spacing:0.03em; }
#cardMount .card-stat-label { font-size:0.32rem; letter-spacing:0.12em; text-transform:uppercase; color:rgba(168,180,192,0.45); }
#cardMount .card-networth { display:flex; align-items:center; justify-content:space-between; padding:2px 2px; }
#cardMount .card-networth-label { font-size:0.36rem; letter-spacing:0.3em; text-transform:uppercase; opacity:0.45; }
#cardMount .card-networth-val { font-size:0.6rem; font-weight:700; letter-spacing:0.05em; color:var(--silver); }
#cardMount .card-badge-block { display:flex; flex-direction:column; gap:5px; }
#cardMount .card-badge-rowlabel { font-size:0.3rem; letter-spacing:0.3em; text-transform:uppercase; opacity:0.35; text-align:center; }
#cardMount .card-badges { display:flex; justify-content:center; gap:6px; }
#cardMount .card-badge { width:32px; height:32px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:1.05rem; border:1.5px solid rgba(201,168,76,0.5); background:rgba(0,0,0,0.55); position:relative; transition:all 0.3s; }
#cardMount .card-badge.earned { background:rgba(0,0,0,0.7); border-color:#F0D080; box-shadow:0 0 12px currentColor, 0 0 20px rgba(240,208,128,0.4); }
#cardMount .card-badge.locked { filter:grayscale(1) brightness(0.3); }
#cardMount .card-badge.earned::after { content:''; position:absolute; inset:-3px; border-radius:50%; border:1px solid currentColor; opacity:0.3; animation:badgePulse 2s ease-in-out infinite; }
@keyframes badgePulse { 0%,100%{opacity:0.3;transform:scale(1);} 50%{opacity:0.6;transform:scale(1.1);} }
#cardMount .card-footer { display:flex; justify-content:space-between; align-items:center; padding-top:2px; }
#cardMount .card-footer-brand { font-size:0.5rem; letter-spacing:0.12em; text-transform:uppercase; opacity:0.75; font-weight:600; white-space:nowrap; padding-left:6px; }
#cardMount .card-footer-wl { font-size:0.42rem; letter-spacing:0.1em; opacity:0.5; }
#cardMount .card-particles { position:absolute; inset:0; pointer-events:none; z-index:3; border-radius:16px; overflow:hidden; }
#cardMount .cp { position:absolute; border-radius:50%; animation:cpFloat linear infinite; }
#cardMount .card-shimmer { position:absolute; inset:0; border-radius:16px; pointer-events:none; z-index:4; background:linear-gradient(105deg, transparent 35%, rgba(255,255,255,0.03) 45%, rgba(255,255,255,0.07) 50%, rgba(255,255,255,0.03) 55%, transparent 65%); animation:shimmerSlide 5s ease-in-out infinite; }
@keyframes shimmerSlide { 0%{transform:translateX(-100%) skewX(-15deg);} 100%{transform:translateX(200%) skewX(-15deg);} }
#cardMount .rank-bronze .card-frame { box-shadow:inset 0 0 0 2px rgba(139,90,43,0.6), 0 0 20px rgba(100,60,20,0.3); }
#cardMount .rank-silver .card-frame { box-shadow:inset 0 0 0 2px rgba(168,180,192,0.7), 0 0 25px rgba(168,180,192,0.2); }
#cardMount .rank-gold .card-frame { box-shadow:inset 0 0 0 2px rgba(201,168,76,0.9), 0 0 40px rgba(201,168,76,0.4); }
#cardMount .rank-diamond .card-frame { box-shadow:inset 0 0 0 2px rgba(139,92,246,0.9), 0 0 50px rgba(139,92,246,0.5), 0 0 100px rgba(139,92,246,0.2); }
#cardMount .rank-legend .card-frame { box-shadow:inset 0 0 0 3px rgba(240,208,128,1), 0 0 80px rgba(201,168,76,0.8), 0 0 160px rgba(201,168,76,0.3); }
#cardMount .rank-legend .card-frame::before { content:''; position:absolute; inset:-2px; border-radius:18px; background:conic-gradient(from 0deg, #C9A84C, #F0D080, #CC2200, #F0D080, #C9A84C); animation:legendBorder 3s linear infinite; z-index:-1; }
@keyframes legendBorder { to { transform:rotate(360deg); } }
#cardMount .rank-diamond .card-frame::before { content:''; position:absolute; inset:0; border-radius:16px; background:linear-gradient(135deg, rgba(139,92,246,0.2), transparent 40%, rgba(196,181,253,0.15), transparent 70%, rgba(139,92,246,0.2)); animation:crystalShift 4s ease-in-out infinite alternate; }
@keyframes crystalShift { from{opacity:0.5;transform:rotate(0deg);} to{opacity:1;transform:rotate(5deg);} }
#cardMount .card-bottom { padding:16px 14px 12px; gap:8px; }
#cardMount .medallion-stage { position:relative; width:158px; height:158px; display:flex; align-items:center; justify-content:center; }
#cardMount .medallion-bezel { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; z-index:1; filter:drop-shadow(0 3px 5px rgba(0,0,0,0.65)); pointer-events:none; }
#cardMount .card-medallion::before, #cardMount .card-medallion::after { display:none; }
#cardMount .card-stats { background:linear-gradient(180deg, rgba(0,0,0,0.5), rgba(0,0,0,0.2)); border-top:1px solid rgba(201,168,76,0.14); border-bottom:1px solid rgba(201,168,76,0.14); border-radius:5px; padding:8px 4px; box-shadow:inset 0 1px 6px rgba(0,0,0,0.5); }
#cardMount .card-stat-val { font-size:0.82rem; letter-spacing:0.02em; text-shadow:0 0 8px rgba(0,0,0,0.7); }
#cardMount .card-stat-label { font-size:0.4rem; letter-spacing:0.14em; }
#cardMount .card-glare { position:absolute; inset:0; border-radius:16px; pointer-events:none; z-index:5; opacity:0; transition:opacity 0.35s ease; mix-blend-mode:soft-light; background:radial-gradient(circle 130px at 50% 50%, rgba(255,255,255,0.55), rgba(255,255,255,0.12) 38%, transparent 68%); }
#cardMount .ww-card:hover .card-glare { opacity:0.85; }
#cardMount .card-emblem { font-size:0.7rem; color:var(--gold); opacity:0.8; letter-spacing:0.1em; }
#cardMount .card-art-zone { flex-direction:column; gap:6px; }
#cardMount .rank-ribbon { padding:4px 24px; font-family:'Cinzel', serif; font-size:0.56rem; font-weight:700; letter-spacing:0.34em; text-transform:uppercase; color:#F0D080; background:linear-gradient(180deg, rgba(0,0,0,0.62), rgba(0,0,0,0.32)); border-top:1px solid rgba(201,168,76,0.5); border-bottom:1px solid rgba(201,168,76,0.5); clip-path:polygon(9px 0, calc(100% - 9px) 0, 100% 50%, calc(100% - 9px) 100%, 9px 100%, 0 50%); box-shadow:0 2px 14px rgba(0,0,0,0.5); z-index:2; text-shadow:0 0 10px rgba(0,0,0,0.6); }
#cardMount .card-inner-frame { position:absolute; inset:0; z-index:6; pointer-events:none; transition:transform 0.12s ease-out; }
#cardMount .medallion-stage { transition:transform 0.12s ease-out; }
#cardMount .ww-card.rank-bronze { box-shadow: 0 0 38px 5px rgba(150,95,40,0.42); }
#cardMount .ww-card.rank-silver { box-shadow: 0 0 42px 6px rgba(212,226,238,0.52), 0 0 84px 16px rgba(180,200,220,0.18); }
#cardMount .ww-card.rank-gold { box-shadow: 0 0 60px 9px rgba(240,190,90,0.58), 0 0 120px 36px rgba(235,150,40,0.22); }
#cardMount .ww-card.rank-diamond { box-shadow: 0 0 54px 8px rgba(90,165,240,0.52), 0 0 112px 28px rgba(120,185,255,0.22); }
#cardMount .ww-card.rank-legend { animation: legendHalo 1.8s ease-in-out infinite; }
@keyframes legendHalo {
  0%,100% { box-shadow: 0 0 50px 8px rgba(240,210,120,0.55), 0 0 100px 24px rgba(255,180,60,0.25), 0 0 140px 40px rgba(120,180,255,0.12); }
  44%     { box-shadow: 0 0 72px 13px rgba(255,242,205,0.82), 0 0 132px 36px rgba(255,200,80,0.36), 0 0 184px 62px rgba(150,200,255,0.26); }
  58%     { box-shadow: 0 0 38px 5px rgba(220,200,120,0.48), 0 0 88px 20px rgba(255,170,60,0.2); }
  72%     { box-shadow: 0 0 64px 11px rgba(255,235,190,0.7), 0 0 120px 30px rgba(180,210,255,0.3); }
}
.ww-tip { position:fixed; z-index:99999; pointer-events:none; opacity:0; transition:opacity 0.15s ease; transform:translate(-50%,-100%); background:linear-gradient(180deg, rgba(22,15,7,0.98), rgba(8,5,2,0.98)); border:1px solid rgba(201,168,76,0.5); border-radius:6px; padding:8px 11px; width:max-content; max-width:210px; box-shadow:0 10px 34px rgba(0,0,0,0.75), 0 0 18px rgba(201,168,76,0.15); }
.ww-tip.show { opacity:1; }
.ww-tip-name { font-family:'Cinzel Decorative', serif; font-size:0.62rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:#F0D080; margin-bottom:3px; }
.ww-tip-desc { font-family:'IM Fell English', serif; font-size:0.66rem; font-style:italic; line-height:1.35; color:rgba(168,180,192,0.85); }
.ww-tip.locked .ww-tip-name { color:#8a8f96; }
.ww-tip.locked .ww-tip-name::after { content:' · locked'; font-family:'Cinzel', serif; font-style:normal; font-size:0.46rem; letter-spacing:0.2em; opacity:0.6; }
#cardMount { position:relative; width:320px; height:560px; display:flex; align-items:center; justify-content:center; margin:30px 0; }
#cardMount .card-empty-bg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:0; pointer-events:none; border-radius:16px; }
#cardMount .card-backdrop { position:absolute; left:50%; top:47%; transform:translate(-50%,-50%); width:100%; height:100%; object-fit:contain; z-index:0; pointer-events:none; opacity:0.82; filter:blur(1.1px) saturate(1.06) brightness(0.92); -webkit-mask:radial-gradient(ellipse 58% 56% at 50% 46%, #000 46%, rgba(0,0,0,0) 100%); mask:radial-gradient(ellipse 58% 56% at 50% 46%, #000 46%, rgba(0,0,0,0) 100%); transition:transform 0.12s ease-out; }
#cardMount .ww-card { z-index:1; }
#cardMount .medallion-img { width:152px; height:152px; object-fit:cover; position:relative; z-index:2; border-radius:50%; clip-path:circle(50% at 50% 50%); box-shadow:0 3px 7px rgba(0,0,0,0.6), 0 0 18px rgba(139,180,255,0.35), 0 0 32px rgba(240,208,128,0.2); }
</style>
<style>
.rank-bronze { --gold:#C9A84C; --gold-l:#F0D080; --gold-d:#8B6914; }
.rank-silver { --gold:#A8B4C0; --gold-l:#E4EAF0; --gold-d:#6B7684; }
.rank-gold { --gold:#E0B84C; --gold-l:#FFE9A8; --gold-d:#A67F1E; }
.rank-diamond { --gold:#7FB8F0; --gold-l:#C0E0FF; --gold-d:#3D6E9E; }
.rank-legend { --gold:#FFD98C; --gold-l:#FFF0C8; --gold-d:#C99A3E; }
</style>
<style>
.rank-silver .side-badge { border-color:rgba(200,220,255,0.6); }
.rank-gold .side-badge { border-color:rgba(240,208,128,0.7); }
.rank-diamond .side-badge { border-color:rgba(139,180,255,0.7); }
.rank-legend .side-badge { border-color:rgba(255,215,140,0.85); box-shadow:0 0 6px rgba(255,215,140,0.4); }
</style>
<style>
.side-badge-column { position:absolute; right:8px; top:75px; display:flex; flex-direction:column; gap:8px; z-index:5; }
.side-badge { width:26px; height:26px; border-radius:6px; display:flex; align-items:center; justify-content:center; font-size:0.8rem; border:1.5px solid rgba(201,168,76,0.5); background:linear-gradient(135deg, rgba(139,105,20,0.3), rgba(0,0,0,0.6)); box-shadow:inset 0 0 4px rgba(0,0,0,0.6), 0 0 4px rgba(201,168,76,0.2); transition:all 0.3s; }
.side-badge.earned { box-shadow:0 0 6px currentColor; border-color:currentColor; opacity:0.95; }
.side-badge.locked { filter:grayscale(1) brightness(0.35); opacity:0.6; }
</style>
<style>
.stat-icon-img { filter:drop-shadow(0 0 4px rgba(201,168,76,0.4)); transition:filter 0.4s ease; }
.rank-silver .stat-icon-img { filter:grayscale(1) brightness(1.4) contrast(1.15) drop-shadow(0 0 6px rgba(200,220,255,0.6)); }
.rank-gold .stat-icon-img { filter:hue-rotate(18deg) saturate(1.6) brightness(1.35) drop-shadow(0 0 6px rgba(240,208,128,0.6)); }
.rank-diamond .stat-icon-img { filter:hue-rotate(190deg) saturate(1.3) brightness(1.2) drop-shadow(0 0 7px rgba(139,180,255,0.6)); }
.rank-legend .stat-icon-img { filter:hue-rotate(20deg) saturate(1.8) brightness(1.5) drop-shadow(0 0 9px rgba(255,215,140,0.8)); animation:legendIconPulse 2s ease-in-out infinite; }
@keyframes legendIconPulse { 0%,100%{filter:hue-rotate(20deg) saturate(1.8) brightness(1.5) drop-shadow(0 0 9px rgba(255,215,140,0.8));} 50%{filter:hue-rotate(22deg) saturate(2) brightness(1.65) drop-shadow(0 0 14px rgba(255,215,140,1));} }
</style>

</head>
<body>

<canvas id="bgCanvas"></canvas>
<div class="bg-axes"></div>
<div class="vignette"></div>

<div class="frame">
  <div class="frame-h top"></div><div class="frame-h bottom"></div>
  <div class="frame-v left"></div><div class="frame-v right"></div>
  <div class="corner tl"><svg viewBox="0 0 90 90" fill="none"><path d="M3 87 L3 3 L87 3" stroke="#C9A84C" stroke-width="1.5" opacity="0.75"/><path d="M3 55 L3 3 L55 3" stroke="#C9A84C" stroke-width="0.6" opacity="0.35"/><circle cx="3" cy="3" r="3.5" fill="#C9A84C" opacity="0.8"/><circle cx="22" cy="3" r="2" fill="#C9A84C" opacity="0.4"/><circle cx="3" cy="22" r="2" fill="#C9A84C" opacity="0.4"/><rect x="9" y="9" width="5" height="5" transform="rotate(45 11.5 11.5)" fill="none" stroke="#C9A84C" stroke-width="0.8" opacity="0.35"/></svg></div>
  <div class="corner tr"><svg viewBox="0 0 90 90" fill="none"><path d="M3 87 L3 3 L87 3" stroke="#C9A84C" stroke-width="1.5" opacity="0.75"/><path d="M3 55 L3 3 L55 3" stroke="#C9A84C" stroke-width="0.6" opacity="0.35"/><circle cx="3" cy="3" r="3.5" fill="#C9A84C" opacity="0.8"/><circle cx="22" cy="3" r="2" fill="#C9A84C" opacity="0.4"/><circle cx="3" cy="22" r="2" fill="#C9A84C" opacity="0.4"/><rect x="9" y="9" width="5" height="5" transform="rotate(45 11.5 11.5)" fill="none" stroke="#C9A84C" stroke-width="0.8" opacity="0.35"/></svg></div>
  <div class="corner bl"><svg viewBox="0 0 90 90" fill="none"><path d="M3 87 L3 3 L87 3" stroke="#C9A84C" stroke-width="1.5" opacity="0.75"/><path d="M3 55 L3 3 L55 3" stroke="#C9A84C" stroke-width="0.6" opacity="0.35"/><circle cx="3" cy="3" r="3.5" fill="#C9A84C" opacity="0.8"/><circle cx="22" cy="3" r="2" fill="#C9A84C" opacity="0.4"/><circle cx="3" cy="22" r="2" fill="#C9A84C" opacity="0.4"/><rect x="9" y="9" width="5" height="5" transform="rotate(45 11.5 11.5)" fill="none" stroke="#C9A84C" stroke-width="0.8" opacity="0.35"/></svg></div>
  <div class="corner br"><svg viewBox="0 0 90 90" fill="none"><path d="M3 87 L3 3 L87 3" stroke="#C9A84C" stroke-width="1.5" opacity="0.75"/><path d="M3 55 L3 3 L55 3" stroke="#C9A84C" stroke-width="0.6" opacity="0.35"/><circle cx="3" cy="3" r="3.5" fill="#C9A84C" opacity="0.8"/><circle cx="22" cy="3" r="2" fill="#C9A84C" opacity="0.4"/><circle cx="3" cy="22" r="2" fill="#C9A84C" opacity="0.4"/><rect x="9" y="9" width="5" height="5" transform="rotate(45 11.5 11.5)" fill="none" stroke="#C9A84C" stroke-width="0.8" opacity="0.35"/></svg></div>
</div>

<div class="embers" id="embers"></div>

<!-- LANDING -->
<div class="main" id="landing">
  <div class="col-text">
    <div class="eyebrow"><div class="eyebrow-line"></div>BASE NETWORK</div>
    <div class="logo">WALLET<br>WARS</div>
    <div class="divider"><div class="divider-line"></div><div class="divider-diamond"></div><div class="divider-line"></div></div>
    <div class="tagline">Your wallet. Your weapon.</div>
    <button class="btn-arena" onclick="openModal()">
      <div class="btn-inner">
        <span class="btn-icon">⚔</span>
        <span class="btn-text">Enter the Arena</span>
        <span class="btn-icon">⚔</span>
      </div>
    </button>
    <div class="sub-cta">Season I · Discord Open · Built on Base</div>
  </div>
  <div class="col-card">
    <div class="combat-card">
      <div class="card-shimmer"></div>
      <div class="card-corner tl"></div><div class="card-corner tr"></div>
      <div class="card-corner bl"></div><div class="card-corner br"></div>
      <div class="card-header"><div class="card-rank">⚔ Season I</div><div class="card-badge">BRONZE</div></div>
      <div class="card-hline"></div>
      <div class="card-avatar-wrap"><div class="card-avatar-ring"></div><div class="card-avatar">🛡</div></div>
      <div class="card-name">— Connect Wallet —</div>
      <div class="card-sub">Your Combat Card awaits</div>
      <div class="card-power-wrap">
        <div class="card-power-label"><span>Wallet Power</span><span style="color:var(--gold)">???</span></div>
        <div class="card-power-bar"><div class="card-power-fill"></div></div>
      </div>
      <div class="card-stats">
        <div class="stat"><div class="stat-label">Volume</div><div class="stat-value">—</div></div>
        <div class="stat"><div class="stat-label">PNL</div><div class="stat-value">—</div></div>
        <div class="stat"><div class="stat-label">Txs</div><div class="stat-value">—</div></div>
        <div class="stat"><div class="stat-label">Age</div><div class="stat-value">—</div></div>
      </div>
      <div class="card-badges">
        <div class="badge">🩸</div><div class="badge">🔥</div>
        <div class="badge locked">💀</div><div class="badge locked">⚡</div><div class="badge locked">👑</div>
      </div>
      <div class="card-hline"></div>
      <button class="card-btn" onclick="openModal()">⚔ &nbsp; Challenge &nbsp; ⚔</button>
    </div>
  </div>
</div>

<div class="season-tag">⚔ &nbsp; WalletWars · Season I · Base Network &nbsp; ⚔</div>

<!-- MODAL -->
<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <div class="modal-corner tl"></div><div class="modal-corner tr"></div>
    <div class="modal-corner bl"></div><div class="modal-corner br"></div>
    <button class="modal-close" onclick="closeModal()">✕</button>
    <div class="modal-icon">⚔</div>
    <div class="modal-title">Connect Your Wallet</div>
    <div class="modal-sub">Choose your weapon to enter the arena</div>
    <div class="modal-divider"></div>
    <button class="wallet-option" onclick="connectWallet('metamask')">
      <div class="wallet-logo metamask">🦊</div>
      <div class="wallet-info"><div class="wallet-name">MetaMask</div><div class="wallet-desc">Browser extension wallet</div></div>
      <div class="wallet-arrow">›</div>
    </button>
    <button class="wallet-option" onclick="connectWallet('coinbase')">
      <div class="wallet-logo coinbase">🔵</div>
      <div class="wallet-info"><div class="wallet-name">Coinbase Wallet</div><div class="wallet-desc">Native Base ecosystem wallet</div></div>
      <div class="wallet-arrow">›</div>
    </button>
    <button class="wallet-option" onclick="connectWallet('walletconnect')">
      <div class="wallet-logo walletconnect">🔗</div>
      <div class="wallet-info"><div class="wallet-name">WalletConnect</div><div class="wallet-desc">Connect any mobile wallet</div></div>
      <div class="wallet-arrow">›</div>
    </button>
    <div class="modal-footer">By connecting you agree to the Terms · Season I</div>
  </div>
</div>

<!-- FORGING -->
<div class="forging-screen" id="forgingScreen">
  <div class="forge-ring-wrap">
    <div class="forge-ring"></div><div class="forge-ring r2"></div><div class="forge-ring r3"></div>
    <div class="forge-sparks" id="forgeSparks"></div>
    <div class="forge-icon">⚔</div>
  </div>
  <div class="forge-title">Forging Your Card</div>
  <div class="forge-msg" id="forgeMsg">Connecting to Base Network...</div>
  <div class="forge-bar-wrap">
    <div class="forge-bar-label"><span>Analyzing Wallet</span><span id="forgePct">0%</span></div>
    <div class="forge-bar-bg"><div class="forge-bar-fill" id="forgeBar"></div></div>
  </div>
  <div class="forge-steps">
    <div class="forge-step" id="step1"><div class="step-dot"></div>Verifying wallet on Base</div>
    <div class="forge-step" id="step2"><div class="step-dot"></div>Reading transaction history</div>
    <div class="forge-step" id="step3"><div class="step-dot"></div>Calculating wallet power</div>
    <div class="forge-step" id="step4"><div class="step-dot"></div>Analyzing PNL & volume</div>
    <div class="forge-step" id="step5"><div class="step-dot"></div>Forging your Combat Card</div>
  </div>
</div>

<!-- PANTALLA 4 -->
<div class="screen4" id="screen4">
  <div class="s4-card-col">
<svg width="0" height="0" style="position:absolute"><defs>
  <linearGradient id="statGold" x1="0%" y1="0%" x2="100%" y2="100%">
    <stop offset="0%" stop-color="#8B6914"/><stop offset="50%" stop-color="#F0D080"/><stop offset="100%" stop-color="#8B6914"/>
  </linearGradient>
  <filter id="statGlow"><feGaussianBlur stdDeviation="0.8" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
</defs></svg>
<div class="card-mount" id="cardMount">
  <img class="card-backdrop" id="cardBackdrop" alt="" style="display:none;">
<div class="ww-card rank-bronze" id="theCard">
  <img class="card-empty-bg" id="cardEmptyBg" src="data:image/jpeg;base64," alt="">
  <div class="card-overlay" id="cardOverlay" style="display:none;"></div>
  <div class="card-particles" id="cardParticles" style="display:none;"></div>
  <div class="card-shimmer"></div>
  <div class="card-glare" id="cardGlare"></div>
  <div class="card-inner-frame" id="cardInnerFrame"></div>
  <div class="card-frame" id="cardFrame"></div>
  <div class="card-content">
    <div class="card-top">
      <div class="card-emblem">⚔</div>
      <div class="card-season">Season I</div>
    </div>
    <div class="card-art-zone">
      <div class="medallion-stage">
        <img class="medallion-img" id="medallionImg" alt="">
      </div>
